@model IEnumerable<spotify_swiss_knife.Models.Attachment>

@functions {
    static string FormatSize(long bytes)
    {
        if (bytes >= 1073741824) return (bytes / 1073741824d).ToString("0.##") + " GB";
        if (bytes >= 1048576) return (bytes / 1048576d).ToString("0.##") + " MB";
        if (bytes >= 1024) return (bytes / 1024d).ToString("0.##") + " KB";
        return bytes + " B";
    }
}

@if (!Model.Any())
{
    <p class="files-empty">No attachments yet.</p>
}
else
{
    <div class="table-wrap">
        <table class="entity-table">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Size</th>
                    <th>Uploaded</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var attachment in Model)
                {
                    <tr>
                        <td data-label="File">
                            <a href="@attachment.FilePath" target="_blank" rel="noopener" download="@attachment.FileName">@attachment.FileName</a>
                        </td>
                        <td data-label="Size">@FormatSize(attachment.FileSize)</td>
                        <td data-label="Uploaded">@attachment.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td data-label="Actions" class="cell-actions">
                            <button type="button" class="btn btn-danger attachment-delete-btn"
                                    data-delete-url="@Url.Action("DeleteAttachment", "Albums", new { id = attachment.Id })"
                                    data-confirm="Delete this attachment?">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
