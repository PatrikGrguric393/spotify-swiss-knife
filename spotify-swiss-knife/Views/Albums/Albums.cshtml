@using System.Text.Json
@model List<spotify_swiss_knife.Models.Album>

@{
    ViewData["Title"] = "Library - Albums";
}

<section class="library-page">
    <h1>Library: Albums</h1>
    <div class="library-filters">
        <div class="library-actions">
            <div class="search-box">
                <label for="albumSearch" class="visually-hidden">Search</label>
                <input id="albumSearch" name="q" type="search" class="search-input" placeholder="Search albums..." aria-label="Search albums" />
                <span class="search-status" aria-live="polite"></span>
            </div>
        </div>

        <div class="date-range-filters">
            <div class="dpc-wrapper" id="wrapperFrom">
                <button type="button" class="dpc-trigger" id="triggerFrom" aria-haspopup="true" aria-expanded="false">From: —</button>
                <div class="dpc-panel" id="panelFrom" hidden>
                    <div class="dpc" id="dpcFrom" data-target="albumDateFrom">
                        <div class="dpc__header">
                            <button type="button" class="dpc__nav" data-dir="-1" aria-label="Previous">&#8249;</button>
                            <button type="button" class="dpc__head-btn" aria-label="Pick year"></button>
                            <button type="button" class="dpc__nav" data-dir="1" aria-label="Next">&#8250;</button>
                        </div>
                        <div class="dpc__year-grid" hidden aria-label="Year picker"></div>
                        <div class="dpc__weekdays" aria-hidden="true"></div>
                        <div class="dpc__grid" role="grid" aria-label="From date"></div>
                    </div>
                </div>
            </div>

            <div class="dpc-wrapper" id="wrapperTo">
                <button type="button" class="dpc-trigger" id="triggerTo" aria-haspopup="true" aria-expanded="false">To: —</button>
                <div class="dpc-panel" id="panelTo" hidden>
                    <div class="dpc" id="dpcTo" data-target="albumDateTo">
                        <div class="dpc__header">
                            <button type="button" class="dpc__nav" data-dir="-1" aria-label="Previous">&#8249;</button>
                            <button type="button" class="dpc__head-btn" aria-label="Pick year"></button>
                            <button type="button" class="dpc__nav" data-dir="1" aria-label="Next">&#8250;</button>
                        </div>
                        <div class="dpc__year-grid" hidden aria-label="Year picker"></div>
                        <div class="dpc__weekdays" aria-hidden="true"></div>
                        <div class="dpc__grid" role="grid" aria-label="To date"></div>
                    </div>
                </div>
            </div>

            <input type="hidden" id="albumDateFrom" />
            <input type="hidden" id="albumDateTo" />
            <button type="button" id="albumDateClear" class="dpc-clear">Clear</button>
        </div>
    </div>

    <p>All albums from the mock repository.</p>

    <div class="table-actions">
        <a class="btn btn-primary" href="@Url.Action("CreateAlbum", "Albums")">Create Album</a>
    </div>

    <div class="table-wrap">
        <table class="entity-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Artists</th>
                    <th>Release Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var album in Model)
            {
                var artists = string.Join(", ", album.Artists.Select(artist => artist.Name));
                var detailsId = $"album-details-{album.Id}";
                var detailPayload = new
                {
                    album.Name,
                    Artists = artists,
                    Type = album.AlbumType,
                    ReleaseDate = album.ReleaseDate,
                    TotalTracks = album.TotalTracks,
                    album.Label,
                    album.Popularity
                };

                <tr tabindex="0" data-details-id="@detailsId" data-entity-type="Album" aria-label="View details for @album.Name">
                    <td data-label="Name">@album.Name</td>
                    <td data-label="Artists">@artists</td>
                    <td data-label="Release Date" data-date="@album.ReleaseDate">@album.ReleaseDate</td>
                    <td data-label="Actions" class="cell-actions">
                        <a class="btn" href="@Url.Action("EditAlbum", "Albums", new { id = album.Id })">Edit</a>
                        <a class="btn btn-danger" href="@Url.Action("DeleteAlbum", "Albums", new { id = album.Id })">Delete</a>
                        <script type="application/json" id="@detailsId">@Html.Raw(JsonSerializer.Serialize(detailPayload))</script>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<div class="entity-detail-backdrop" id="entityDetailBackdrop" hidden>
    <section class="entity-detail-modal" role="dialog" aria-modal="true" aria-labelledby="entityDetailTitle">
        <div class="entity-detail-header">
            <h2 id="entityDetailTitle">Details</h2>
            <button type="button" class="entity-detail-close" id="entityDetailClose" aria-label="Close details">Close</button>
        </div>
        <div class="entity-detail-body">
            <div class="entity-detail-content" id="entityDetailContent"></div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/album-form-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/library-albums.js" asp-append-version="true"></script>
}