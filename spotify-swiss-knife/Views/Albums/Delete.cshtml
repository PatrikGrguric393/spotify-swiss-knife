@model spotify_swiss_knife.Models.Album

@{
    ViewData["Title"] = "Delete Album";
    ViewBag.EntityType = "Album";
    ViewBag.EntityName = Model.Name;
    ViewBag.CancelUrl = Url.Action("Index", "Albums");
    ViewBag.Warning = "Tracks linked to this album will remain in the library and lose their album association.";
}

<partial name="_ConfirmDelete" />
