@using spotify_swiss_knife.Models.FormModels;

@model AlbumCreateForm

@{
    ViewData["Title"] = "Create Album";
}

<div class="form-container">
    <h2>Create New Album</h2>

    <form method="post" id="createAlbumForm" data-validate="true" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <partial name="_AlbumFormFields" model="Model" />

        <div class="form-group album-cover-field">
            <label asp-for="CoverImage"></label>
            <p class="album-cover-help">Optional. JPG, PNG, GIF or WebP.</p>

            <div class="album-cover-preview" data-album-cover-preview hidden>
                <img src="" alt="Selected album cover preview" data-album-cover-preview-img />
            </div>

            <input asp-for="CoverImage"
                   type="file"
                   class="form-control album-cover-input"
                   accept="image/jpeg,image/png,image/gif,image/webp,.jpg,.jpeg,.png,.gif,.webp"
                   data-album-cover-input
                   data-album-cover-preview-target="[data-album-cover-preview]"
                   aria-describedby="error-CoverImage" />
            @{
                var coverErrors = ViewData.ModelState["CoverImage"]?.Errors;
                if (coverErrors != null && coverErrors.Count > 0)
                {
                    <div class="validation-error show" id="error-CoverImage" role="alert" aria-live="polite">
                        @foreach (var error in coverErrors)
                        {
                            <div class="validation-error-message">@error.ErrorMessage</div>
                        }
                    </div>
                }
                else
                {
                    <div class="validation-error" id="error-CoverImage" role="alert" aria-live="polite"></div>
                }
            }
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Album</button>
            <a href="@Url.Action("Index", "Albums")" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/album-form-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/album-track-picker.js" asp-append-version="true"></script>
    <script src="~/js/album-artist-picker.js" asp-append-version="true"></script>
    <script src="~/js/album-cover-preview.js" asp-append-version="true"></script>
}