@model spotify_swiss_knife.Models.FormModels.UserEditForm

@{
    ViewData["Title"] = "Edit user";
    var roles = ViewBag.Roles as string[] ?? Array.Empty<string>();
    var dobValue = Model.DateOfBirth?.ToString("yyyy-MM-dd") ?? string.Empty;
    var dobLabel = "Pick a date";
}

<div class="form-container">
    <h2>Edit user</h2>

    <form asp-controller="Account" asp-action="EditUser" asp-route-id="@Model.Id" method="post" id="editUserForm" data-validate="true">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Email" class="required"></label>
            <input asp-for="Email" class="form-control" type="email" autocomplete="email" required placeholder="you@example.com" aria-describedby="error-Email" />
            <partial name="_FieldErrors" model="@("Email")" />
        </div>

        <div class="form-group">
            <label asp-for="FirstName" class="required"></label>
            <input asp-for="FirstName" class="form-control" autocomplete="given-name" required maxlength="100" data-val-length-max="100" placeholder="Enter first name" aria-describedby="error-FirstName" />
            <partial name="_FieldErrors" model="@("FirstName")" />
        </div>

        <div class="form-group">
            <label asp-for="LastName" class="required"></label>
            <input asp-for="LastName" class="form-control" autocomplete="family-name" required maxlength="100" data-val-length-max="100" placeholder="Enter last name" aria-describedby="error-LastName" />
            <partial name="_FieldErrors" model="@("LastName")" />
        </div>

        <div class="form-group">
            <label asp-for="DateOfBirth" for="editUserDobTrigger"></label>
            <div class="dpc-wrapper dpc-wrapper--field" id="wrapperEditUserDob">
                <button type="button" class="dpc-trigger" id="editUserDobTrigger" aria-haspopup="true" aria-expanded="false" aria-describedby="error-DateOfBirth">@dobLabel</button>
                <div class="dpc-panel" id="panelEditUserDob" hidden>
                    <div class="dpc" id="dpcEditUserDob" data-target="editUserDob">
                        <div class="dpc__header">
                            <button type="button" class="dpc__nav" data-dir="-1" aria-label="Previous">&#8249;</button>
                            <button type="button" class="dpc__head-btn" aria-label="Pick year"></button>
                            <button type="button" class="dpc__nav" data-dir="1" aria-label="Next">&#8250;</button>
                        </div>
                        <div class="dpc__year-grid" hidden aria-label="Year picker"></div>
                        <div class="dpc__weekdays" aria-hidden="true"></div>
                        <div class="dpc__grid" role="grid" aria-label="Date of birth"></div>
                    </div>
                </div>
            </div>
            <input type="hidden" name="DateOfBirth" id="editUserDob" value="@dobValue" />
            <partial name="_FieldErrors" model="@("DateOfBirth")" />
        </div>

        <div class="form-group">
            <label asp-for="OIB" class="required"></label>
            <input asp-for="OIB" class="form-control" inputmode="numeric" autocomplete="off" required maxlength="11" data-val-length-max="11" pattern="[0-9]{11}" placeholder="Enter 11-digit OIB" aria-describedby="error-OIB" />
            <partial name="_FieldErrors" model="@("OIB")" />
        </div>

        <div class="form-group">
            <label asp-for="JMBAG" class="required"></label>
            <input asp-for="JMBAG" class="form-control" inputmode="numeric" autocomplete="off" required maxlength="10" data-val-length-max="10" pattern="[0-9]{10}" placeholder="Enter 10-digit JMBAG" aria-describedby="error-JMBAG" />
            <partial name="_FieldErrors" model="@("JMBAG")" />
        </div>

        <div class="form-group">
            <label asp-for="Role"></label>
            <select asp-for="Role" class="form-control"
                    asp-items="@(new SelectList(roles))"
                    aria-describedby="error-Role">
            </select>
            <partial name="_FieldErrors" model="@("Role")" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a class="btn" asp-controller="Account" asp-action="Users">Back to users</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/album-form-datepicker.js" asp-append-version="true"></script>
}
</content>
