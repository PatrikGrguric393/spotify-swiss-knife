@model spotify_swiss_knife.Models.FormModels.UserRegisterForm

@{
    ViewData["Title"] = "Register";
    var returnUrl = ViewData["ReturnUrl"] as string ?? string.Empty;
    var dobValue = Model.DateOfBirth?.ToString("yyyy-MM-dd") ?? string.Empty;
    var dobLabel = Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd MMM yyyy") : "Pick a date";

    void FieldErrors(string field)
    {
        var errors = ViewData.ModelState[field]?.Errors;
        if (errors != null && errors.Count > 0)
        {
            <div class="validation-error show" id="error-@field" role="alert" aria-live="polite">
                @foreach (var error in errors)
                {
                    <div class="validation-error-message">@error.ErrorMessage</div>
                }
            </div>
        }
        else
        {
            <div class="validation-error" id="error-@field" role="alert" aria-live="polite"></div>
        }
    }
}

<div class="form-container">
    <h2>Create an account</h2>

    <form asp-controller="Account" asp-action="Register" method="post" id="registerForm" data-validate="true">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@returnUrl" />

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Email" class="required"></label>
            <input asp-for="Email" class="form-control" type="email" autocomplete="email" required placeholder="you@example.com" aria-describedby="error-Email" />
            @{ FieldErrors("Email"); }
        </div>

        <div class="form-group">
            <label asp-for="FirstName" class="required"></label>
            <input asp-for="FirstName" class="form-control" autocomplete="given-name" required maxlength="100" data-val-length-max="100" placeholder="Enter your first name" aria-describedby="error-FirstName" />
            @{ FieldErrors("FirstName"); }
        </div>

        <div class="form-group">
            <label asp-for="LastName" class="required"></label>
            <input asp-for="LastName" class="form-control" autocomplete="family-name" required maxlength="100" data-val-length-max="100" placeholder="Enter your last name" aria-describedby="error-LastName" />
            @{ FieldErrors("LastName"); }
        </div>

        <div class="form-group">
            <label asp-for="DateOfBirth" for="registerDobTrigger"></label>
            <div class="dpc-wrapper dpc-wrapper--field" id="wrapperRegisterDob">
                <button type="button" class="dpc-trigger" id="registerDobTrigger" aria-haspopup="true" aria-expanded="false" aria-describedby="error-DateOfBirth">@dobLabel</button>
                <div class="dpc-panel" id="panelRegisterDob" hidden>
                    <div class="dpc" id="dpcRegisterDob" data-target="registerDob">
                        <div class="dpc__header">
                            <button type="button" class="dpc__nav" data-dir="-1" aria-label="Previous">&#8249;</button>
                            <button type="button" class="dpc__head-btn" aria-label="Pick year"></button>
                            <button type="button" class="dpc__nav" data-dir="1" aria-label="Next">&#8250;</button>
                        </div>
                        <div class="dpc__year-grid" hidden aria-label="Year picker"></div>
                        <div class="dpc__weekdays" aria-hidden="true"></div>
                        <div class="dpc__grid" role="grid" aria-label="Date of birth"></div>
                    </div>
                </div>
            </div>
            <input type="hidden" name="DateOfBirth" id="registerDob" value="@dobValue" />
            @{ FieldErrors("DateOfBirth"); }
        </div>

        <div class="form-group">
            <label asp-for="OIB" class="required"></label>
            <input asp-for="OIB" class="form-control" inputmode="numeric" autocomplete="off" required maxlength="11" data-val-length-max="11" pattern="[0-9]{11}" placeholder="Enter your 11-digit OIB" aria-describedby="error-OIB" />
            @{ FieldErrors("OIB"); }
        </div>

        <div class="form-group">
            <label asp-for="JMBAG" class="required"></label>
            <input asp-for="JMBAG" class="form-control" inputmode="numeric" autocomplete="off" required maxlength="10" data-val-length-max="10" pattern="[0-9]{10}" placeholder="Enter your 10-digit JMBAG" aria-describedby="error-JMBAG" />
            @{ FieldErrors("JMBAG"); }
        </div>

        <div class="form-group">
            <label asp-for="Password" class="required"></label>
            <input asp-for="Password" id="Password" class="form-control" type="password" autocomplete="new-password" required placeholder="At least 6 characters" aria-describedby="error-Password" />
            @{ FieldErrors("Password"); }
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword" class="required"></label>
            <input asp-for="ConfirmPassword" id="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" required data-match="#Password" placeholder="Re-enter your password" aria-describedby="error-ConfirmPassword" />
            @{ FieldErrors("ConfirmPassword"); }
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Register</button>
        </div>
    </form>

    <p class="auth-alt-action">
        Already have an account?
        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">Log in</a>
    </p>
</div>

@section Scripts {
    <script src="~/js/album-form-datepicker.js" asp-append-version="true"></script>
}
