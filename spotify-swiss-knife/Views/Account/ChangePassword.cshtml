@model spotify_swiss_knife.Models.FormModels.UserChangePasswordForm

@{
    ViewData["Title"] = "Change password";
    var passwordMessage = TempData["PasswordMessage"] as string;
}

<div class="form-container">
    <h2>Change password</h2>

    @if (!string.IsNullOrWhiteSpace(passwordMessage))
    {
        <div class="shuffle-notice" role="status" aria-live="polite">
            <p class="shuffle-notice-text">@passwordMessage</p>
        </div>
    }

    <form asp-controller="Account" asp-action="ChangePassword" method="post" id="changePasswordForm" data-validate="true">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="CurrentPassword" class="required"></label>
            <input asp-for="CurrentPassword" class="form-control" type="password" autocomplete="current-password" required placeholder="Enter your current password" aria-describedby="error-CurrentPassword" />
            <partial name="_FieldErrors" model="@("CurrentPassword")" />
        </div>

        <div class="form-group">
            <label asp-for="NewPassword" class="required"></label>
            <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" required placeholder="Enter a new password" aria-describedby="error-NewPassword" />
            <partial name="_FieldErrors" model="@("NewPassword")" />
        </div>

        <div class="form-group">
            <label asp-for="ConfirmNewPassword" class="required"></label>
            <input asp-for="ConfirmNewPassword" class="form-control" type="password" autocomplete="new-password" required placeholder="Re-enter the new password" aria-describedby="error-ConfirmNewPassword" />
            <partial name="_FieldErrors" model="@("ConfirmNewPassword")" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Change password</button>
        </div>
    </form>
</div>
