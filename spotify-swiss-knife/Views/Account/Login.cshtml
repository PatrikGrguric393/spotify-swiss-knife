@model spotify_swiss_knife.Models.FormModels.UserLoginForm

@{
    ViewData["Title"] = "Log in";
    var returnUrl = ViewData["ReturnUrl"] as string ?? string.Empty;
}

<div class="form-container">
    <h2>Log in</h2>

    <form asp-controller="Account" asp-action="Login" method="post" id="loginForm" data-validate="true">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@returnUrl" />

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Email" class="required"></label>
            <input asp-for="Email" class="form-control" type="email" autocomplete="email" required placeholder="you@example.com" aria-describedby="error-Email" />
            <partial name="_FieldErrors" model="@("Email")" />
        </div>

        <div class="form-group">
            <label asp-for="Password" class="required"></label>
            <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" required placeholder="Enter your password" aria-describedby="error-Password" />
            <partial name="_FieldErrors" model="@("Password")" />
        </div>

        <div class="form-group">
            <label class="shuffle-checkbox" for="RememberMe">
                <input asp-for="RememberMe" type="checkbox" />
                <span>@Html.DisplayNameFor(m => m.RememberMe)</span>
            </label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Log in</button>
        </div>
    </form>

    <p class="auth-alt-action">
        New here?
        <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@returnUrl">Create an account</a>
    </p>
</div>
