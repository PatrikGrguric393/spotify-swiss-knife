@model spotify_swiss_knife.Models.ShufflePlaylistPage

@{
    ViewData["Title"] = "Shuffle Playlist";
}

<section class="library-page shuffle-page">
    <h1>Shuffle Playlist</h1>
    <p>Select a playlist, choose randomness, and start the shuffle immediately.</p>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <section class="shuffle-notice shuffle-notice-error" role="alert" aria-labelledby="shuffleErrorTitle">
            <h2 id="shuffleErrorTitle" class="shuffle-notice-title">Playlists unavailable</h2>
            <p class="shuffle-notice-text">@Model.ErrorMessage</p>
        </section>
    }
    else
    {
        <section class="shuffle-panel" aria-labelledby="shuffleControlsTitle">
            <h2 id="shuffleControlsTitle" class="shuffle-panel-title">Shuffle a playlist</h2>

            <form action="@Url.Action("ShufflePlaylist", "Services")" method="post" class="shuffle-form">
                @Html.AntiForgeryToken()

                <div class="shuffle-form-pair">
                    <div class="shuffle-form-row">
                        <label asp-for="Input.PlaylistId">Playlist</label>
                        <select asp-for="Input.PlaylistId" class="shuffle-input" required>
                            <option value="">Select playlist</option>
                            @foreach (var playlist in Model.Playlists)
                            {
                                <option value="@playlist.Id">@playlist.Name (@playlist.Tracks.Total tracks)</option>
                            }
                        </select>
                        <span class="shuffle-validation" asp-validation-for="Input.PlaylistId"></span>
                    </div>

                    <div class="shuffle-form-row">
                        <label asp-for="Input.RandomnessLevel">Randomness level</label>
                        <select asp-for="Input.RandomnessLevel" class="shuffle-input">
                            @foreach (var level in Enum.GetValues<spotify_swiss_knife.Models.ShuffleRandomnessLevel>())
                            {
                                <option value="@level">@level</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="shuffle-form-actions">
                    <button type="submit" class="shuffle-submit">
                        <span class="shuffle-spinner" aria-hidden="true"></span>
                        <span class="shuffle-submit-label">Start shuffle</span>
                    </button>
                </div>

                <p class="shuffle-status" role="status" aria-live="polite" aria-atomic="true">
                    @(string.IsNullOrWhiteSpace(Model.StatusMessage) ? "No shuffle has been run yet." : Model.StatusMessage)
                </p>

                @if (Model.ShuffledAtUtc.HasValue)
                {
                    <p class="shuffle-last-run">
                        Last shuffled:
                        <time class="shuffle-time" datetime="@Model.ShuffledAtUtc.Value.ToString("o")" data-utc="@Model.ShuffledAtUtc.Value.ToString("o")"></time>
                    </p>
                }

            </form>
        </section>
    }

</section>

@section Scripts {
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.shuffle-time[data-utc]').forEach(function (el) {
            var parsed = new Date(el.dataset.utc);
            if (!Number.isNaN(parsed.getTime())) {
                el.textContent = parsed.toLocaleString();
            }
        });

        document.querySelectorAll('.shuffle-form').forEach(function (form) {
            var submit = form.querySelector('.shuffle-submit');
            var label = form.querySelector('.shuffle-submit-label');
            var status = form.querySelector('.shuffle-status');
            var inFlight = false;

            form.addEventListener('submit', function (event) {
                if (inFlight) {
                    event.preventDefault();
                    return;
                }
                inFlight = true;

                if (submit) {
                    submit.disabled = true;
                    submit.setAttribute('aria-busy', 'true');
                    submit.classList.add('is-shuffling');
                }
                if (label) {
                    label.textContent = 'Shuffling…';
                }
                if (status) {
                    status.textContent = 'Shuffling…';
                }
            });
        });
    });
    </script>
}
