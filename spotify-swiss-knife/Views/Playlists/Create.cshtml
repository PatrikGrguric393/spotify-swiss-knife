@using Microsoft.AspNetCore.Mvc.Rendering
@using spotify_swiss_knife.Models.FormModels;

@model PlaylistCreateForm

@{
    ViewData["Title"] = "Create Playlist";
}

<div class="form-container">
    <h2>Create New Playlist</h2>

    <form method="post" action="@Url.Action("CreatePost", "Playlists")" id="createPlaylistForm" data-validate="true">
        @Html.AntiForgeryToken()

        <partial name="_PlaylistFormFields" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Playlist</button>
            <a href="@Url.Action("Index", "Playlists")" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/filter-picker.js" asp-append-version="true"></script>
}
