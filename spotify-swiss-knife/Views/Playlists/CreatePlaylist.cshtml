@using Microsoft.AspNetCore.Mvc.Rendering
@using spotify_swiss_knife.Models.FormModels;

@model PlaylistCreateForm

@{
    ViewData["Title"] = "Create Playlist";
}

<div class="form-container">
    <h2>Create New Playlist</h2>

    <form method="post" action="@Url.Action("CreatePlaylistPost", "Playlists")" id="createPlaylistForm" data-validate="true">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label asp-for="Name" class="required"></label>
            <input asp-for="Name" class="form-control" required maxlength="200" data-val-length-max="200" data-val-length-min="1" placeholder="Enter playlist name" aria-describedby="error-Name" />
            @{
                var nameErrors = ViewData.ModelState["Name"]?.Errors;
                if (nameErrors != null && nameErrors.Count > 0)
                {
                    <div class="validation-error show" id="error-Name" role="alert" aria-live="polite">
                        @foreach (var error in nameErrors)
                        {
                            <div class="validation-error-message">@error.ErrorMessage</div>
                        }
                    </div>
                }
                else
                {
                    <div class="validation-error" id="error-Name" role="alert" aria-live="polite"></div>
                }
            }
        </div>

        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control" maxlength="500" data-val-length-max="500" rows="4" placeholder="Enter description (optional)" aria-describedby="error-Description"></textarea>
            @{
                var descriptionErrors = ViewData.ModelState["Description"]?.Errors;
                if (descriptionErrors != null && descriptionErrors.Count > 0)
                {
                    <div class="validation-error show" id="error-Description" role="alert" aria-live="polite">
                        @foreach (var error in descriptionErrors)
                        {
                            <div class="validation-error-message">@error.ErrorMessage</div>
                        }
                    </div>
                }
                else
                {
                    <div class="validation-error" id="error-Description" role="alert" aria-live="polite"></div>
                }
            }
        </div>

        <div class="form-group album-track-picker" data-playlist-track-picker>
            <fieldset class="album-track-picker-fieldset">
                <legend>Songs</legend>
                <p class="album-track-picker-help">Search songs, then check every song you want in this playlist.</p>
                <label class="album-track-picker-search-label" for="playlistTrackSearch">Search songs</label>
                <input id="playlistTrackSearch" type="search" class="form-control album-track-picker-search" placeholder="Search by song name" autocomplete="off" data-playlist-track-search aria-describedby="playlistTrackPickerStatus error-TrackIds" />
                <div class="album-track-picker-status" id="playlistTrackPickerStatus" role="status" aria-live="polite"></div>

                <div class="album-track-picker-list entity-selection-list" role="group" aria-label="Available songs">
                    @{
                        var selectedTrackIds = new HashSet<string>(Model.TrackIds ?? []);
                        var trackOptions = ViewBag.TrackOptions as IEnumerable<SelectListItem> ?? [];
                        foreach (var trackOption in trackOptions)
                        {
                            var optionId = $"playlist-track-option-{trackOption.Value}";
                            var optionText = trackOption.Text ?? string.Empty;
                            var searchValue = optionText.ToLowerInvariant();
                            var isSelected = selectedTrackIds.Contains(trackOption.Value ?? string.Empty) || trackOption.Selected;

                            <label class="album-track-picker-item entity-selection-item" data-playlist-track-row data-search-text="@searchValue">
                                <input id="@optionId" type="checkbox" name="TrackIds" value="@trackOption.Value" @(isSelected ? "checked" : null) data-playlist-track-checkbox />
                                <span class="album-track-picker-item-text">@optionText</span>
                            </label>
                        }
                    }
                </div>

                @{
                    var trackIdErrors = ViewData.ModelState["TrackIds"]?.Errors;
                    if (trackIdErrors != null && trackIdErrors.Count > 0)
                    {
                        <div class="validation-error show" id="error-TrackIds" role="alert" aria-live="polite">
                            @foreach (var error in trackIdErrors)
                            {
                                <div class="validation-error-message">@error.ErrorMessage</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="validation-error" id="error-TrackIds" role="alert" aria-live="polite"></div>
                    }
                }
            </fieldset>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Playlist</button>
            <a href="@Url.Action("Playlists", "Playlists")" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/playlist-track-picker.js" asp-append-version="true"></script>
}
