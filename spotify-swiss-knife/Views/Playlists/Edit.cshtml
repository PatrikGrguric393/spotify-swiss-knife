@using Microsoft.AspNetCore.Mvc.Rendering
@using spotify_swiss_knife.Models.FormModels;

@model PlaylistEditForm

@{
    ViewData["Title"] = "Edit Playlist";
}

<div class="form-container">
    <h2>Edit Playlist</h2>

    <form method="post" id="editPlaylistForm" data-validate="true">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <partial name="_PlaylistFormFields" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="@Url.Action("Index", "Playlists")" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/filter-picker.js" asp-append-version="true"></script>
}
