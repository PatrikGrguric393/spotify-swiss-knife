@using System.Text.Json
@model List<spotify_swiss_knife.Models.Playlist>

@{
    ViewData["Title"] = "Library - Playlists";
}

<section class="library-page">
    <h1>Library: Playlists</h1>
    <div class="library-filters">
        <div class="library-actions">
            <div class="search-box">
                <label for="playlistSearch" class="visually-hidden">Search</label>
                <input id="playlistSearch" name="q" type="search" class="search-input" placeholder="Search playlists..." aria-label="Search playlists" />
                <span class="search-status" aria-live="polite"></span>
            </div>
        </div>

        <div class="date-range-filters">
            <span class="filter-group-label">Last Shuffled</span>
            <div class="dpc-wrapper" id="wrapperFrom">
                <button type="button" class="dpc-trigger" id="triggerFrom" aria-haspopup="true" aria-expanded="false">From: —</button>
                <div class="dpc-panel" id="panelFrom" hidden>
                    <div class="dpc" id="dpcFrom" data-target="playlistDateFrom">
                        <div class="dpc__header">
                            <button type="button" class="dpc__nav" data-dir="-1" aria-label="Previous">&#8249;</button>
                            <button type="button" class="dpc__head-btn" aria-label="Pick year"></button>
                            <button type="button" class="dpc__nav" data-dir="1" aria-label="Next">&#8250;</button>
                        </div>
                        <div class="dpc__year-grid" hidden aria-label="Year picker"></div>
                        <div class="dpc__weekdays" aria-hidden="true"></div>
                        <div class="dpc__grid" role="grid" aria-label="From date"></div>
                    </div>
                </div>
            </div>

            <div class="dpc-wrapper" id="wrapperTo">
                <button type="button" class="dpc-trigger" id="triggerTo" aria-haspopup="true" aria-expanded="false">To: —</button>
                <div class="dpc-panel" id="panelTo" hidden>
                    <div class="dpc" id="dpcTo" data-target="playlistDateTo">
                        <div class="dpc__header">
                            <button type="button" class="dpc__nav" data-dir="-1" aria-label="Previous">&#8249;</button>
                            <button type="button" class="dpc__head-btn" aria-label="Pick year"></button>
                            <button type="button" class="dpc__nav" data-dir="1" aria-label="Next">&#8250;</button>
                        </div>
                        <div class="dpc__year-grid" hidden aria-label="Year picker"></div>
                        <div class="dpc__weekdays" aria-hidden="true"></div>
                        <div class="dpc__grid" role="grid" aria-label="To date"></div>
                    </div>
                </div>
            </div>

            <input type="hidden" id="playlistDateFrom" />
            <input type="hidden" id="playlistDateTo" />
            <button type="button" id="playlistDateClear" class="dpc-clear" aria-label="Clear date filter">
                <svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 12 12"><line x1="1" y1="1" x2="11" y2="11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="11" y1="1" x2="1" y2="11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
        </div>
    </div>
    <p>All playlists from the mock repository.</p>

    <div class="table-actions">
        <a class="btn btn-primary" href="@Url.Action("Create", "Playlists")">Create Playlist</a>
    </div>

    <div class="table-wrap">
        <table class="entity-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Owner</th>
                    <th>Tracks</th>
                    <th>Last Shuffled</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var playlist in Model)
            {
                var contentsId = $"playlist-contents-{playlist.Id}";

                <tr tabindex="0" data-contents-id="@contentsId" aria-label="View tracks for @playlist.Name">
                    <td data-label="Name">@playlist.Name</td>
                    <td data-label="Owner">@(playlist.Owner.DisplayName ?? "Unknown")</td>
                    <td data-label="Tracks">@playlist.Tracks.Total</td>
                    <td data-label="Last Shuffled" @(playlist.LastShuffled.HasValue ? Html.Raw($"data-utc=\"{playlist.LastShuffled.Value.ToUniversalTime().ToString("O")}\"") : Html.Raw(""))>@(playlist.LastShuffled.HasValue ? "" : "Never")</td>
                    <td data-label="Actions" class="cell-actions">
                        <a class="btn" href="@Url.Action("Edit", "Playlists", new { id = playlist.Id })">Edit</a>
                        <a class="btn btn-danger" href="@Url.Action("Delete", "Playlists", new { id = playlist.Id })">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<div class="playlist-contents-backdrop" id="playlistContentsBackdrop" hidden>
    <section class="playlist-contents-modal" role="dialog" aria-modal="true" aria-labelledby="playlistContentsTitle">
        <div class="playlist-contents-header">
            <h2 id="playlistContentsTitle">Playlist Contents</h2>
            <button type="button" class="playlist-contents-close" id="playlistContentsClose" aria-label="Close">Close</button>
        </div>
        <div class="playlist-contents-body">
            <table class="entity-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Song</th>
                        <th>Artist(s)</th>
                        <th>Duration</th>
                    </tr>
                </thead>
                <tbody id="playlistContentsTable">
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/album-form-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/library-list.js" asp-append-version="true"></script>
    <script src="~/js/library-playlists.js" asp-append-version="true"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        window.DateFmt.localizePending();
    });
    </script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        var backdrop = document.getElementById('playlistContentsBackdrop');
        var closeBtn = document.getElementById('playlistContentsClose');
        var table = document.getElementById('playlistContentsTable');
        var playlists = @Html.Raw(JsonSerializer.Serialize(Model));
        var lastTriggerRow = null;

        function formatDuration(ms) {
            var seconds = Math.floor(ms / 1000);
            var minutes = Math.floor(seconds / 60);
            var secs = seconds % 60;
            return minutes + ':' + (secs < 10 ? '0' : '') + secs;
        }

        function openPlaylist(row) {
            var contentsId = row.dataset.contentsId;
            var playlistId = contentsId.replace('playlist-contents-', '');
            var playlist = playlists.find(function (p) { return p.id === playlistId; });

            if (!playlist) return;

            document.getElementById('playlistContentsTitle').textContent = playlist.name + ' - ' + playlist.tracks.items.length + ' tracks';

            var rows = '';
            playlist.tracks.items.forEach(function (item, index) {
                var track = item.track;
                if (!track) return;
                var artists = track.artists.map(function (a) { return a.name; }).join(', ');
                var duration = formatDuration(track.duration_ms);
                rows += '<tr><td data-label="#">' + (index + 1) + '</td><td data-label="Song">' + track.name + '</td><td data-label="Artist(s)">' + artists + '</td><td data-label="Duration">' + duration + '</td></tr>';
            });
            table.innerHTML = rows;

            backdrop.hidden = false;
            backdrop.setAttribute('aria-hidden', 'false');
            closeBtn.focus();
        }

        function closePlaylist() {
            backdrop.hidden = true;
            backdrop.setAttribute('aria-hidden', 'true');
            if (lastTriggerRow && typeof lastTriggerRow.focus === 'function') {
                lastTriggerRow.focus();
            }
        }

        document.querySelector('.entity-table tbody').addEventListener('click', function (e) {
            if (e.target.closest('a, button')) return;
            var row = e.target.closest('tr[data-contents-id]');
            if (!row) return;
            lastTriggerRow = row;
            openPlaylist(row);
        });

        document.querySelector('.entity-table tbody').addEventListener('keydown', function (e) {
            if (e.key !== 'Enter' && e.key !== ' ') return;
            var row = e.target.closest('tr[data-contents-id]');
            if (!row) return;
            e.preventDefault();
            lastTriggerRow = row;
            openPlaylist(row);
        });

        closeBtn.addEventListener('click', closePlaylist);

        backdrop.addEventListener('click', function (e) {
            if (e.target === backdrop) closePlaylist();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !backdrop.hidden) closePlaylist();
        });

        var selectedId = new URLSearchParams(window.location.search).get('selected');
        if (selectedId) {
            var selectedRow = document.querySelector('tr[data-contents-id="playlist-contents-' + selectedId + '"]');
            if (selectedRow) {
                lastTriggerRow = selectedRow;
                openPlaylist(selectedRow);
            }
        }
    });
    </script>
}