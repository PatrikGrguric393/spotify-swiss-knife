@using System.Text.Json
@model List<spotify_swiss_knife.Models.Playlist>

@{
    ViewData["Title"] = "Library - Playlists";
}

<section class="library-page">
    <h1>Library: Playlists</h1>
    <div class="library-filters">
        <div class="library-actions">
            <div class="search-box">
                <label for="playlistSearch" class="visually-hidden">Search</label>
                <input id="playlistSearch" name="q" type="search" class="search-input" placeholder="Search playlists..." aria-label="Search playlists" />
                <span class="search-status" aria-live="polite"></span>
            </div>
        </div>

        <div class="date-range-filters">
            <span class="filter-group-label">Last Shuffled</span>
            <div class="dpc-wrapper" id="wrapperFrom">
                <button type="button" class="dpc-trigger" id="triggerFrom" aria-haspopup="true" aria-expanded="false">From: —</button>
                <div class="dpc-panel" id="panelFrom" hidden>
                    <div class="dpc" id="dpcFrom" data-target="playlistDateFrom">
                        <div class="dpc__header">
                            <button type="button" class="dpc__nav" data-dir="-1" aria-label="Previous">&#8249;</button>
                            <button type="button" class="dpc__head-btn" aria-label="Pick year"></button>
                            <button type="button" class="dpc__nav" data-dir="1" aria-label="Next">&#8250;</button>
                        </div>
                        <div class="dpc__year-grid" hidden aria-label="Year picker"></div>
                        <div class="dpc__weekdays" aria-hidden="true"></div>
                        <div class="dpc__grid" role="grid" aria-label="From date"></div>
                    </div>
                </div>
            </div>

            <div class="dpc-wrapper" id="wrapperTo">
                <button type="button" class="dpc-trigger" id="triggerTo" aria-haspopup="true" aria-expanded="false">To: —</button>
                <div class="dpc-panel" id="panelTo" hidden>
                    <div class="dpc" id="dpcTo" data-target="playlistDateTo">
                        <div class="dpc__header">
                            <button type="button" class="dpc__nav" data-dir="-1" aria-label="Previous">&#8249;</button>
                            <button type="button" class="dpc__head-btn" aria-label="Pick year"></button>
                            <button type="button" class="dpc__nav" data-dir="1" aria-label="Next">&#8250;</button>
                        </div>
                        <div class="dpc__year-grid" hidden aria-label="Year picker"></div>
                        <div class="dpc__weekdays" aria-hidden="true"></div>
                        <div class="dpc__grid" role="grid" aria-label="To date"></div>
                    </div>
                </div>
            </div>

            <input type="hidden" id="playlistDateFrom" />
            <input type="hidden" id="playlistDateTo" />
            <button type="button" id="playlistDateClear" class="dpc-clear" aria-label="Clear date filter">
                <svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 12 12"><line x1="1" y1="1" x2="11" y2="11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="11" y1="1" x2="1" y2="11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
        </div>
    </div>
    <div class="table-actions">
        <a class="btn btn-primary" href="@Url.Action("Create", "Playlists")">Create Playlist</a>
    </div>

    <div class="table-wrap">
        <table class="entity-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Owner</th>
                    <th>Tracks</th>
                    <th>Last Shuffled</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var playlist in Model)
            {
                var detailsId = $"playlist-details-{playlist.Id}";
                var owner = playlist.Owner.DisplayName ?? "Unknown";
                var trackItems = playlist.Tracks.Items
                    .Select(item => item.Track)
                    .Where(track => track != null)
                    .Select((track, index) => new Dictionary<string, object>
                    {
                        ["#"] = index + 1,
                        ["Song"] = track.Name,
                        ["Artists"] = string.Join(", ", track.Artists.Select(artist => artist.Name)),
                        ["Duration"] = TimeSpan.FromMilliseconds(track.DurationMs).ToString(@"m\:ss")
                    });
                var detailPayload = new
                {
                    playlist.Name,
                    Owner = owner,
                    TrackCount = playlist.Tracks.Total,
                    LastShuffled = playlist.LastShuffled.HasValue
                        ? playlist.LastShuffled.Value.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ssZ")
                        : null,
                    Description = string.IsNullOrWhiteSpace(playlist.Description) ? null : playlist.Description,
                    Tracks = trackItems
                };

                <tr tabindex="0" data-details-id="@detailsId" data-entity-type="Playlist" aria-label="View tracks for @playlist.Name">
                    <td data-label="Name">@playlist.Name</td>
                    <td data-label="Owner">@owner</td>
                    <td data-label="Tracks">@playlist.Tracks.Total</td>
                    <td data-label="Last Shuffled" @(playlist.LastShuffled.HasValue ? Html.Raw($"data-utc=\"{playlist.LastShuffled.Value.ToUniversalTime().ToString("O")}\"") : Html.Raw(""))>@(playlist.LastShuffled.HasValue ? "" : "Never")</td>
                    <td data-label="Actions" class="cell-actions">
                        <a class="btn" href="@Url.Action("Edit", "Playlists", new { id = playlist.Id })">Edit</a>
                        <a class="btn btn-danger" href="@Url.Action("Delete", "Playlists", new { id = playlist.Id })">Delete</a>
                        <script type="application/json" id="@detailsId">@Html.Raw(JsonSerializer.Serialize(detailPayload))</script>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<partial name="_EntityDetailModal" />

@section Scripts {
    <script src="~/js/album-form-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/library-list.js" asp-append-version="true"></script>
    <script src="~/js/library-playlists.js" asp-append-version="true"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        window.DateFmt.localizePending();
    });
    </script>
}