@using System.Text.Json
@model List<spotify_swiss_knife.Models.Artist>

@{
    ViewData["Title"] = "Library - Artists";
}

<section class="library-page">
    <h1>Library: Artists</h1>
    <p>All artists from the mock repository.</p>

    <div class="table-wrap">
        <table class="entity-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Spotify URL</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var artist in Model)
            {
                var detailsId = $"artist-details-{artist.Id}";
                var detailPayload = new
                {
                    artist.Name,
                    artist.Id,
                    SpotifyUrl = artist.ExternalUrls.Spotify
                };

                <tr>
                    <td data-label="Name">@artist.Name</td>
                    <td data-label="Spotify URL">
                        <a href="@artist.ExternalUrls.Spotify" target="_blank" rel="noopener noreferrer">
                            Open
                        </a>
                    </td>
                    <td data-label="Details" class="cell-actions">
                        <button type="button" class="entity-detail-trigger" data-details-id="@detailsId" data-entity-type="Artist">
                            View
                        </button>
                        <script type="application/json" id="@detailsId">@Html.Raw(JsonSerializer.Serialize(detailPayload))</script>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<div class="entity-detail-backdrop" id="entityDetailBackdrop" hidden>
    <section class="entity-detail-modal" role="dialog" aria-modal="true" aria-labelledby="entityDetailTitle">
        <div class="entity-detail-header">
            <h2 id="entityDetailTitle">Details</h2>
            <button type="button" class="entity-detail-close" id="entityDetailClose" aria-label="Close details">Close</button>
        </div>
        <div class="entity-detail-body">
            <div class="entity-detail-content" id="entityDetailContent"></div>
        </div>
    </section>
</div>