@using System.Text.Json
@model List<spotify_swiss_knife.Models.Artist>

@{
    ViewData["Title"] = "Library - Artists";
}

<section class="library-page">
    <h1>Library: Artists</h1>
    <div class="library-actions">
        <div class="search-box">
            <label for="artistSearch" class="visually-hidden">Search</label>
            <input id="artistSearch" name="q" type="search" class="search-input" placeholder="Search artists..." aria-label="Search artists" />
            <span class="search-status" aria-live="polite"></span>
        </div>
    </div>

    <p>All artists from the mock repository.</p>

    <div class="table-actions">
        <a class="btn btn-primary" href="@Url.Action("CreateArtist", "Library")">Create Artist</a>
    </div>

    <div class="table-wrap">
        <table class="entity-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Spotify URL</th>
                    <th>Details</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var artist in Model)
            {
                var detailsId = $"artist-details-{artist.Id}";
                var detailPayload = new
                {
                    artist.Name,
                    artist.Id,
                    SpotifyUrl = artist.ExternalUrls.Spotify
                };

                <tr>
                    <td data-label="Name">@artist.Name</td>
                    <td data-label="Spotify URL">
                        <a href="@artist.ExternalUrls.Spotify" target="_blank" rel="noopener noreferrer">
                            Open
                        </a>
                    </td>
                    <td data-label="Details" class="cell-actions">
                        <button type="button" class="entity-detail-trigger btn" data-details-id="@detailsId" data-entity-type="Artist">
                            View
                        </button>
                        <script type="application/json" id="@detailsId">@Html.Raw(JsonSerializer.Serialize(detailPayload))</script>
                    </td>
                    <td data-label="Actions" class="cell-actions">
                        <a class="btn" href="@Url.Action("EditArtist", "Library", new { id = artist.Id })">Edit</a>
                        <a class="btn btn-danger" href="@Url.Action("DeleteArtist", "Library", new { id = artist.Id })">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<div class="entity-detail-backdrop" id="entityDetailBackdrop" hidden>
    <section class="entity-detail-modal" role="dialog" aria-modal="true" aria-labelledby="entityDetailTitle">
        <div class="entity-detail-header">
            <h2 id="entityDetailTitle">Details</h2>
            <button type="button" class="entity-detail-close" id="entityDetailClose" aria-label="Close details">Close</button>
        </div>
        <div class="entity-detail-body">
            <div class="entity-detail-content" id="entityDetailContent"></div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/library-artists.js" asp-append-version="true"></script>
    <script src="~/js/library-details.js" asp-append-version="true"></script>
}