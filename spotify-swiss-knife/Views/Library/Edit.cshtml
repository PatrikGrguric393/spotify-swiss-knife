@using spotify_swiss_knife.Models.FormModels;

@model ArtistEditModel

@{
    ViewData["Title"] = "Edit Artist";
    ViewData["ExcludeIdSelector"] = "#Id";
}

<div class="form-container">
    <h2>Edit Artist</h2>

    <form method="post" id="editArtistForm" data-validate="true">
        @Html.AntiForgeryToken()
        <input type="hidden" id="Id" name="Id" value="@Model.Id" />

        @Html.Partial("_NameInput", Model)
        @Html.Partial("_SpotifyUrlInput", Model)
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="@Url.Action("Artists", "Library")" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/form-validation.js"></script>
}
