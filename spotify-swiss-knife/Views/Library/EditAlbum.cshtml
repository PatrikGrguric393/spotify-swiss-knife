@using spotify_swiss_knife.Models.FormModels;

@model AlbumEditModel

@{
    ViewData["Title"] = "Edit Album";
}

<div class="form-container">
    <h2>Edit Album</h2>

    <form method="post" id="editAlbumForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <partial name="_AlbumFormFields" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="@Url.Action("Albums", "Library")" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>