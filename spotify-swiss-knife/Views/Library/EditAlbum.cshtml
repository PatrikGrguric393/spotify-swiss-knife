@using spotify_swiss_knife.Models.FormModels;

@model AlbumEditModel

@{
    ViewData["Title"] = "Edit Album";
}

<div class="form-container">
    <h2>Edit Album</h2>

    <form method="post" id="editAlbumForm" data-validate="true">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <partial name="_AlbumFormFields" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="@Url.Action("Albums", "Library")" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/album-form-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/album-track-picker.js" asp-append-version="true"></script>
    <script src="~/js/album-artist-picker.js" asp-append-version="true"></script>
}