@{
    ViewData["Title"] = "About";
}

<div class="about-container">
    <h1>About Spotify Swiss Knife</h1>
    <p>Spotify Swiss Knife is a powerful utility application designed to enhance your Spotify experience with advanced playlist management and music library tools.</p>
    
    <section class="about-section">
        <h2>Features</h2>
        <ul>
            <li>Playlist Shuffler - Randomize your playlists with different randomness levels</li>
            <li>Playlist Downloader - Download your favorite playlists</li>
            <li>Bulk Album Saver - Save multiple albums at once to your library</li>
        </ul>
    </section>

    <section class="about-section">
        <h2>Library Management</h2>
        <p>Easily browse and manage your music library with organized views for:</p>
        <ul>
            <li>Songs</li>
            <li>Albums</li>
            <li>Artists</li>
            <li>Playlists</li>
        </ul>
    </section>
</div>
