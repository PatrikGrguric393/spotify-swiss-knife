@using Microsoft.AspNetCore.Mvc.Rendering
@model spotify_swiss_knife.Models.FormModels.TrackForm


<div class="form-group">
    <label asp-for="Name" class="required"></label>
    <input asp-for="Name" class="form-control" required maxlength="300" data-val-length-max="300" data-val-length-min="1" placeholder="Enter song name" aria-describedby="error-Name" />
    <partial name="_FieldErrors" model="@("Name")" />
</div>

<div class="form-group">
    <label asp-for="TrackNumber"></label>
    <input asp-for="TrackNumber" class="form-control" type="number" min="0" max="500" aria-describedby="error-TrackNumber" />
    <partial name="_FieldErrors" model="@("TrackNumber")" />
</div>

<div class="form-group">
    <label asp-for="DiscNumber"></label>
    <input asp-for="DiscNumber" class="form-control" type="number" min="0" max="5" aria-describedby="error-DiscNumber" />
    <partial name="_FieldErrors" model="@("DiscNumber")" />
</div>

<div class="form-group">
    <label asp-for="Duration" class="required">Duration</label>
    <input asp-for="Duration" class="form-control" type="text" required pattern="\d+(:[0-5]\d)?" title="Enter seconds (e.g. 213) or minutes:seconds (e.g. 3:33)" placeholder="3:33 or 213" aria-describedby="duration-hint error-Duration" />
    <p class="album-track-picker-help" id="duration-hint">Enter seconds (213) or minutes:seconds (3:33).</p>
    <partial name="_FieldErrors" model="@("Duration")" />
</div>

<div class="form-group">
    <label class="shuffle-checkbox" for="IsLocal">
        <input asp-for="IsLocal" type="checkbox" />
        <span>@Html.DisplayNameFor(m => m.IsLocal)</span>
    </label>
    <partial name="_FieldErrors" model="@("IsLocal")" />
</div>

<div class="form-group album-track-picker album-artist-picker" data-album-artist-picker>
    <fieldset class="album-track-picker-fieldset">
        <legend asp-for="ArtistIds"></legend>
        <p class="album-track-picker-help" data-album-artist-help>Search artists, then check every artist on this track.</p>
        <label class="album-track-picker-search-label" for="songArtistSearch">Search artists</label>
        <input id="songArtistSearch" type="search" class="form-control album-track-picker-search" placeholder="Search by artist name" autocomplete="off" data-album-artist-search aria-describedby="songArtistPickerStatus error-ArtistIds" />
        <div class="album-track-picker-status" id="songArtistPickerStatus" role="status" aria-live="polite"></div>

        <div class="album-track-picker-list entity-selection-list" role="group" aria-label="Available artists">
            @{
                var selectedArtistIds = new HashSet<string>(Model.ArtistIds ?? []);
                var artistOptions = ViewBag.ArtistOptions as IEnumerable<SelectListItem> ?? [];
                foreach (var artistOption in artistOptions)
                {
                    var optionId = $"artist-option-{artistOption.Value}";
                    var optionText = artistOption.Text ?? string.Empty;
                    var searchValue = optionText.ToLowerInvariant();
                    var isSelected = selectedArtistIds.Contains(artistOption.Value ?? string.Empty) || artistOption.Selected;

                    <label class="album-track-picker-item entity-selection-item" data-album-artist-row data-search-text="@searchValue">
                        <input id="@optionId" type="checkbox" name="ArtistIds" value="@artistOption.Value" @(isSelected ? "checked" : null) data-album-artist-checkbox />
                        <span class="album-track-picker-item-text">@optionText</span>
                    </label>
                }
            }
        </div>

        <partial name="_FieldErrors" model="@("ArtistIds")" />
    </fieldset>
</div>
