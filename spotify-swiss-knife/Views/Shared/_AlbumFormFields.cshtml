@using Microsoft.AspNetCore.Mvc.Rendering
@model spotify_swiss_knife.Models.FormModels.AlbumForm

@{
    var normalizedAlbumType = (Model.AlbumType ?? string.Empty).Trim().ToLowerInvariant();
    var hasSelectedAlbumType = normalizedAlbumType == "album" || normalizedAlbumType == "single" || normalizedAlbumType == "compilation";
}

<div class="form-group">
    <label asp-for="Name" class="required"></label>
    <input asp-for="Name" class="form-control" required maxlength="300" data-val-length-max="300" data-val-length-min="1" placeholder="Enter album name" aria-describedby="error-Name" />
    <partial name="_FieldErrors" model="@("Name")" />
</div>

<div class="form-group">
    <label asp-for="AlbumType" class="required"></label>
    <select asp-for="AlbumType" class="form-control" required aria-describedby="error-AlbumType" data-album-type-select>
        <option value="">Select album type</option>
        <option value="album">Album</option>
        <option value="single">Single</option>
        <option value="compilation">Compilation</option>
    </select>
    <partial name="_FieldErrors" model="@("AlbumType")" />
</div>

<div class="form-group album-track-picker album-artist-picker" data-album-artist-picker>
    <fieldset class="album-track-picker-fieldset" data-required-group data-required-group-message="Select at least one artist.">
        <legend asp-for="ArtistIds" class="required"></legend>
        <p class="album-track-picker-help" data-album-artist-help>Search artists, then check every artist on this album.</p>
        <label class="album-track-picker-search-label" for="albumArtistSearch">Search artists</label>
        <input id="albumArtistSearch" type="search" class="form-control album-track-picker-search" placeholder="Search by artist name" autocomplete="off" data-album-artist-search aria-describedby="albumArtistPickerStatus error-ArtistIds" />
        <div class="album-track-picker-status" id="albumArtistPickerStatus" role="status" aria-live="polite"></div>

        <div class="album-track-picker-list entity-selection-list" role="group" aria-label="Available artists">
            @{
                var selectedArtistIds = new HashSet<string>(Model.ArtistIds ?? []);
                var artistOptions = ViewBag.ArtistOptions as IEnumerable<SelectListItem> ?? [];
                foreach (var artistOption in artistOptions)
                {
                    var optionId = $"artist-option-{artistOption.Value}";
                    var optionText = artistOption.Text ?? string.Empty;
                    var searchValue = optionText.ToLowerInvariant();
                    var isSelected = selectedArtistIds.Contains(artistOption.Value ?? string.Empty) || artistOption.Selected;

                    <label class="album-track-picker-item entity-selection-item" data-album-artist-row data-search-text="@searchValue">
                        <input id="@optionId" type="checkbox" name="ArtistIds" value="@artistOption.Value" @(isSelected ? "checked" : null) data-album-artist-checkbox />
                        <span class="album-track-picker-item-text">@optionText</span>
                    </label>
                }
            }
        </div>

        <partial name="_FieldErrors" model="@("ArtistIds")" />
    </fieldset>
</div>

<div class="form-group album-track-picker @(hasSelectedAlbumType ? string.Empty : "album-track-picker-locked")" data-album-track-picker>
    <fieldset class="album-track-picker-fieldset" data-required-group data-required-group-message="Select at least one track.">
        <legend asp-for="TrackIds" class="required"></legend>
        <p class="album-track-picker-rule" data-album-track-constraint role="status" aria-live="polite"></p>
        <label class="album-track-picker-search-label" for="albumTrackSearch">Search songs</label>
        <input id="albumTrackSearch" type="search" class="form-control album-track-picker-search" placeholder="Search by song name" autocomplete="off" data-album-track-search aria-describedby="albumTrackPickerStatus error-TrackIds" @(hasSelectedAlbumType ? null : "disabled") />
        <div class="album-track-picker-status" id="albumTrackPickerStatus" role="status" aria-live="polite"></div>

        <div class="album-track-picker-list entity-selection-list" role="group" aria-label="Available songs">
            @{
                var selectedTrackIds = new HashSet<string>(Model.TrackIds ?? []);
                var trackOptions = ViewBag.TrackOptions as IEnumerable<SelectListItem> ?? [];
                foreach (var trackOption in trackOptions)
                {
                    var optionId = $"track-option-{trackOption.Value}";
                    var optionText = trackOption.Text ?? string.Empty;
                    var searchValue = optionText.ToLowerInvariant();
                    var isSelected = selectedTrackIds.Contains(trackOption.Value ?? string.Empty) || trackOption.Selected;

                    <label class="album-track-picker-item entity-selection-item" data-album-track-row data-search-text="@searchValue">
                        <input id="@optionId" type="checkbox" name="TrackIds" value="@trackOption.Value" @(isSelected ? "checked" : null) data-album-track-checkbox @(hasSelectedAlbumType ? null : "disabled") />
                        <span class="album-track-picker-item-text">@optionText</span>
                    </label>
                }
            }
        </div>

        <partial name="_FieldErrors" model="@("TrackIds")" />
    </fieldset>
</div>

<div class="form-group">
    <label asp-for="Label"></label>
    <input asp-for="Label" class="form-control" maxlength="100" placeholder="Enter label (optional)" aria-describedby="error-Label" />
    <partial name="_FieldErrors" model="@("Label")" />
</div>

<div class="form-group">
    <label asp-for="Popularity"></label>
    <input asp-for="Popularity" class="form-control" type="number" min="0" max="100" aria-describedby="error-Popularity" />
    <partial name="_FieldErrors" model="@("Popularity")" />
</div>

<div class="form-group">
    @{
        var releaseDateErrors = ViewData.ModelState["ReleaseDate"]?.Errors;
    }
    <span id="label-ReleaseDate" class="form-group-label required">Release Date</span>
    <div class="dpc-wrapper dpc-wrapper--field @(releaseDateErrors != null && releaseDateErrors.Count > 0 ? "dpc-wrapper--error" : "")"
         id="wrapperReleaseDate"
         aria-describedby="error-ReleaseDate">
        <button type="button" class="dpc-trigger" id="triggerReleaseDate"
                aria-haspopup="true" aria-expanded="false"
                aria-labelledby="label-ReleaseDate">—</button>
        <div class="dpc-panel" id="panelReleaseDate" hidden>
            <div class="dpc" id="dpcReleaseDate" data-target="releaseDate">
                <div class="dpc__header">
                    <button type="button" class="dpc__nav" data-dir="-1" aria-label="Previous">&#8249;</button>
                    <button type="button" class="dpc__head-btn" aria-label="Pick year"></button>
                    <button type="button" class="dpc__nav" data-dir="1" aria-label="Next">&#8250;</button>
                </div>
                <div class="dpc__year-grid" hidden aria-label="Year picker"></div>
                <div class="dpc__weekdays" aria-hidden="true"></div>
                <div class="dpc__grid" role="grid" aria-label="Release date"></div>
            </div>
        </div>
    </div>
    <input type="hidden" asp-for="ReleaseDate" id="releaseDate" />
    <partial name="_FieldErrors" model="@("ReleaseDate")" />
</div>
