@model dynamic

@{
    var nameValue = Model?.Name ?? "";
    var urlValue = Model?.SpotifyUrl ?? string.Empty;
    var excludeIdSelector = ViewData["ExcludeIdSelector"] as string ?? string.Empty;
}

<div class="form-group">
    <label for="Name" class="required">Artist Name</label>
    <input
        type="text"
        id="Name"
        name="Name"
        class="form-control"
        value="@nameValue"
        required
        maxlength="300"
        data-val-length-max="300"
        data-val-length-min="1"
        placeholder="Enter artist name"
        aria-label="Artist Name"
        aria-describedby="error-Name"
        data-validate-name="true"
        data-validate-url="/lib/artists/validate-name"
        @Html.Raw(string.IsNullOrWhiteSpace(excludeIdSelector) ? string.Empty : $" data-exclude-id-selector=\"{excludeIdSelector}\"")
    />

    @{
        var nameErrors = ViewData.ModelState["Name"]?.Errors;
        if (nameErrors != null && nameErrors.Count > 0)
        {
            <div class="validation-error show" id="error-Name" role="alert" aria-live="polite">
                @foreach (var error in nameErrors)
                {
                    <div class="validation-error-message">@error.ErrorMessage</div>
                }
            </div>
        }
        else
        {
            <div class="validation-error" id="error-Name" role="alert" aria-live="polite"></div>
        }
    }
</div>

<div class="form-group">
    <label for="SpotifyUrl">Spotify URL</label>
    <input
        type="url"
        id="SpotifyUrl"
        name="SpotifyUrl"
        class="form-control"
        value="@urlValue"
        maxlength="500"
        placeholder="https://open.spotify.com/artist/..."
        aria-describedby="error-SpotifyUrl"
        data-validate-spotify="true"
    />

    @{
        var urlErrors = ViewData.ModelState["SpotifyUrl"]?.Errors;
        if (urlErrors != null && urlErrors.Count > 0)
        {
            <div class="validation-error show" id="error-SpotifyUrl" role="alert" aria-live="polite">
                <div class="validation-error-message">@urlErrors[0].ErrorMessage</div>
            </div>
        }
        else
        {
            <div class="validation-error" id="error-SpotifyUrl" role="alert" aria-live="polite"></div>
        }
    }
</div>
