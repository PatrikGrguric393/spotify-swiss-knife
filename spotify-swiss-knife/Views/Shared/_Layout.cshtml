<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Spotify Swiss Knife</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/validation.css" asp-append-version="true">
    @RenderSection("Head", required: false)
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
        var isShufflePlaylist = currentController == "Shuffle" && currentAction == "Index";
        var isSchedules = currentController == "Schedules";
        var isBulkAlbumSave = currentController == "BulkAlbumSave";
        var isServices = isShufflePlaylist || isSchedules || isBulkAlbumSave;
        var isLibrary = currentController is "Tracks" or "Albums" or "Artists" or "Playlists" or "Files";
        var spotifyConnected = (await Context.AuthenticateAsync("SpotifyConnect")).Succeeded;
        var appUserRole = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Editor") ? "Editor" : string.Empty;
        var isProfile = (currentController == "Account");
    }

    <header class="app-header">
        <div class="header-container">
            <h1 class="app-title">
                <a asp-controller="Home" asp-action="Index" class="app-title-link"><span class="app-title-full">Spotify Swiss Knife</span><span class="app-title-short">SSK</span></a>
            </h1>
            @await Html.PartialAsync("_GlobalSearch")
            <nav class="app-nav">
                <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <ul class="nav-list" id="navList" tabindex="0" aria-label="Main navigation menu">
                    <li class="nav-dropdown @(isServices ? "active" : string.Empty)" id="servicesDropdown">
                        <button type="button" class="nav-link nav-dropdown-toggle @(isServices ? "active" : string.Empty)" id="servicesToggle" aria-expanded="false" aria-controls="servicesMenu">
                            Services
                        </button>
                        <ul class="dropdown-menu" id="servicesMenu" aria-label="Services menu">
                            <li><a asp-controller="Shuffle" asp-action="Index" class="nav-submenu-link @(isShufflePlaylist ? "active" : string.Empty)">Shuffle playlist</a></li>
                            <li><a asp-controller="Schedules" asp-action="Index" class="nav-submenu-link @(isSchedules ? "active" : string.Empty)">Scheduled shuffles</a></li>
                            <li><a asp-controller="BulkAlbumSave" asp-action="Index" class="nav-submenu-link @(isBulkAlbumSave ? "active" : string.Empty)">Bulk album save</a></li>
                        </ul>
                    </li>
                    <li class="nav-dropdown @(isLibrary ? "active" : string.Empty)" id="libraryDropdown">
                        <button type="button" class="nav-link nav-dropdown-toggle @(isLibrary ? "active" : string.Empty)" id="libraryToggle" aria-expanded="false" aria-controls="libraryMenu">
                            Library
                        </button>
                        <ul class="dropdown-menu" id="libraryMenu" aria-label="Library menu">
                            <li><a asp-controller="Tracks" asp-action="Index" class="nav-submenu-link @(currentController == "Tracks" ? "active" : string.Empty)">Songs</a></li>
                            <li><a asp-controller="Albums" asp-action="Index" class="nav-submenu-link @(currentController == "Albums" ? "active" : string.Empty)">Albums</a></li>
                            <li><a asp-controller="Artists" asp-action="Index" class="nav-submenu-link @(currentController == "Artists" ? "active" : string.Empty)">Artists</a></li>
                            <li><a asp-controller="Playlists" asp-action="Index" class="nav-submenu-link @(currentController == "Playlists" ? "active" : string.Empty)">Playlists</a></li>
                            <li><a asp-controller="Files" asp-action="Index" class="nav-submenu-link @(currentController == "Files" ? "active" : string.Empty)">Files</a></li>
                        </ul>
                    </li>
                    <li><a asp-controller="About" asp-action="Index" class="nav-link @(currentController == "About" ? "active" : string.Empty)">About</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-dropdown @(isProfile ? "active" : string.Empty)" id="profileDropdown">
                            <button type="button" class="nav-link nav-dropdown-toggle @(isProfile ? "active" : string.Empty)" id="profileToggle" aria-expanded="false" aria-controls="profileMenu">
                                @User.Identity.Name@if (!string.IsNullOrEmpty(appUserRole)){<span class="nav-auth-role">@appUserRole</span>}
                            </button>
                            <ul class="dropdown-menu" id="profileMenu" aria-label="Profile menu">
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a asp-controller="Account" asp-action="Users" class="nav-submenu-link @(currentController == "Account" && currentAction == "Users" ? "active" : string.Empty)">Users</a></li>
                                }
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="nav-submenu-logout-form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="nav-submenu-link nav-submenu-logout-btn">Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else if (spotifyConnected)
                    {
                        <li class="nav-dropdown" id="profileDropdown">
                            <button type="button" class="nav-link nav-dropdown-toggle nav-spotify-status" id="profileToggle" aria-expanded="false" aria-controls="profileMenu">
                                Spotify &#10003;
                            </button>
                            <ul class="dropdown-menu" id="profileMenu" aria-label="Profile menu">
                                <li>
                                    <form asp-controller="SpotifyAuth" asp-action="Logout" method="post" class="nav-submenu-logout-form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="nav-submenu-link nav-submenu-logout-btn">Disconnect</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a asp-controller="Login" asp-action="Index" class="nav-link nav-login-btn">Log in</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </header>

    <div class="app-scroll-area">
        <main class="app-content">
            @RenderBody()
        </main>

        <footer class="app-footer">
            <p>&copy; 2026 Spotify Swiss Knife. All rights reserved.</p>
        </footer>
    </div>

    <script src="~/js/date-format.js" asp-append-version="true"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    <script src="~/js/global-search.js" asp-append-version="true"></script>
    <script src="~/js/marquee-placeholder.js" asp-append-version="true"></script>
    <script src="~/js/library-details.js" asp-append-version="true"></script>
    <script src="~/js/library-autorefresh.js" asp-append-version="true"></script>
    <script src="~/js/validation.js" asp-append-version="true"></script>

    <script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('form[data-submit-once]').forEach(function (form) {
            form.addEventListener('submit', function () {
                var btn = form.querySelector('button[type=submit]');
                if (btn) btn.disabled = true;
            });
        });
    });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
