<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Spotify Swiss Knife</title>
    <link rel="stylesheet" href="~/css/site.css">
    <link rel="stylesheet" href="~/css/layout.css">
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
        var isShufflePlaylist = currentController == "Services" && currentAction == "ShufflePlaylist";
        var isServices = isShufflePlaylist;
        var isLibrary = currentController == "Library";
    }

    <header class="app-header">
        <div class="header-container">
            <h1 class="app-title">
                <a asp-controller="Home" asp-action="Index" class="app-title-link">Spotify Swiss Knife</a>
            </h1>
            <nav class="app-nav">
                <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <ul class="nav-list" id="navList" tabindex="0" aria-label="Main navigation menu">
                    <li class="nav-dropdown @(isServices ? "active" : string.Empty)" id="servicesDropdown">
                        <button type="button" class="nav-link nav-dropdown-toggle @(isServices ? "active" : string.Empty)" id="servicesToggle" aria-expanded="false" aria-controls="servicesMenu">
                            Services
                        </button>
                        <ul class="dropdown-menu" id="servicesMenu" aria-label="Services menu">
                            <li><a asp-controller="Services" asp-action="ShufflePlaylist" class="nav-submenu-link @(isShufflePlaylist ? "active" : string.Empty)">Shuffle playlist</a></li>
                        </ul>
                    </li>
                    <li class="nav-dropdown @(isLibrary ? "active" : string.Empty)" id="libraryDropdown">
                        <button type="button" class="nav-link nav-dropdown-toggle @(isLibrary ? "active" : string.Empty)" id="libraryToggle" aria-expanded="false" aria-controls="libraryMenu">
                            Library
                        </button>
                        <ul class="dropdown-menu" id="libraryMenu" aria-label="Library menu">
                            <li><a asp-controller="Library" asp-action="Songs" class="nav-submenu-link @(isLibrary && currentAction == "Songs" ? "active" : string.Empty)">Songs</a></li>
                            <li><a asp-controller="Library" asp-action="Albums" class="nav-submenu-link @(isLibrary && currentAction == "Albums" ? "active" : string.Empty)">Albums</a></li>
                            <li><a asp-controller="Library" asp-action="Artists" class="nav-submenu-link @(isLibrary && currentAction == "Artists" ? "active" : string.Empty)">Artists</a></li>
                            <li><a asp-controller="Library" asp-action="Playlists" class="nav-submenu-link @(isLibrary && currentAction == "Playlists" ? "active" : string.Empty)">Playlists</a></li>
                        </ul>
                    </li>
                    <li><a asp-controller="About" asp-action="Index" class="nav-link @(currentController == "About" ? "active" : string.Empty)">About</a></li>
                    <li><a href="#" class="nav-link">Settings</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <div class="app-scroll-area">
        <main class="app-content">
            @RenderBody()
        </main>

        <footer class="app-footer">
            <p>&copy; 2026 Spotify Swiss Knife. All rights reserved.</p>
        </footer>
    </div>

    <script src="~/js/layout.js"></script>
    <script src="~/js/library-details.js"></script>
</body>
</html>
