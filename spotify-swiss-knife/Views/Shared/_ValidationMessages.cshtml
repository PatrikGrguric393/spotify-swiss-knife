@{
    var modelState = ViewData.ModelState;
    var propertyName = ViewBag.PropertyName as string ?? string.Empty;
    var errorId = string.IsNullOrEmpty(propertyName) ? string.Empty : $"error-{propertyName}";
}

@if (!string.IsNullOrEmpty(propertyName) && modelState.TryGetValue(propertyName, out var entry))
{
    var errors = entry.Errors;
    if (errors.Count > 0)
    {
        <div class="validation-error show" id="@errorId" role="alert" aria-live="polite">
            @foreach (var error in errors)
            {
                <div class="validation-error-message">
                    @error.ErrorMessage
                </div>
            }
        </div>
        return;
    }
}

<div class="validation-error" id="@errorId" role="alert" aria-live="polite"></div>
