@using spotify_swiss_knife.Models.FormModels;
@model TrackCreateForm

@{
    ViewData["Title"] = "Create Song";
}

<div class="form-container">
    <h2>Create New Song</h2>

    <form method="post" action="@Url.Action("CreatePost", "Tracks")" id="createSongForm" data-validate="true">
        @Html.AntiForgeryToken()

        <partial name="_TrackFormFields" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Song</button>
            <a href="@Url.Action("Index", "Tracks")" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/filter-picker.js" asp-append-version="true"></script>
}
