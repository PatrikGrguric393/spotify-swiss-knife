@using spotify_swiss_knife.Models.FormModels;
@model TrackEditForm

@{
    ViewData["Title"] = "Edit Song";
}

<div class="form-container">
    <h2>Edit Song</h2>

    <form method="post" id="editSongForm" data-validate="true">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <partial name="_TrackFormFields" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="@Url.Action("Index", "Tracks")" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/filter-picker.js" asp-append-version="true"></script>
}
