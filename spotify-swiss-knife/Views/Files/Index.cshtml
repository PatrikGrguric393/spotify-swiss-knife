@{
    ViewData["Title"] = "Files";
}

@section Head {
    <link rel="stylesheet" href="https://unpkg.com/dropzone@5/dist/min/dropzone.min.css">
}

<div class="library-page">
    <h1>Files</h1>

    @Html.AntiForgeryToken()

    <div class="library-filters">
        <div class="library-actions">
            <div class="search-box">
                <label for="fileSearch" class="visually-hidden">Search</label>
                <input id="fileSearch" name="q" type="search" class="search-input" placeholder="Search files..." aria-label="Search files" disabled />
                <span class="search-status" aria-live="polite"></span>
            </div>
        </div>
    </div>

    <section class="files-upload" aria-labelledby="files-upload-heading">
        <h2 id="files-upload-heading" class="files-upload-heading">Upload files</h2>
        <p class="files-upload-help">Drop files here or click to select. Up to 512&nbsp;MB per file.</p>
        <div id="files-dropzone" class="dropzone files-dropzone"
             role="button"
             aria-label="Upload files. Drop files here or click to select."></div>
    </section>

    <div class="files-section">
        <div id="files-list-container">
            <p class="files-empty">Loading...</p>
        </div>
    </div>
</div>

<div id="delete-confirm-backdrop"
     class="entity-detail-backdrop"
     hidden
     role="dialog"
     aria-modal="true"
     aria-labelledby="delete-confirm-title">
    <div class="entity-detail-modal confirm-modal">
        <div class="entity-detail-header">
            <h2 id="delete-confirm-title">Delete file</h2>
            <button class="entity-detail-close"
                    id="delete-confirm-close"
                    type="button"
                    aria-label="Close">&times;</button>
        </div>
        <div class="entity-detail-body">
            <p class="confirm-modal-message" id="delete-confirm-message"></p>
        </div>
        <div class="confirm-modal-footer">
            <button class="btn" id="delete-confirm-cancel" type="button">Cancel</button>
            <button class="btn btn-danger" id="delete-confirm-ok" type="button">Delete</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const antiforgeryToken = () =>
            document.querySelector('input[name="__RequestVerificationToken"]').value;

        function formatSize(bytes) {
            if (bytes >= 1073741824) return (bytes / 1073741824).toFixed(2) + ' GB';
            if (bytes >= 1048576)    return (bytes / 1048576).toFixed(2) + ' MB';
            if (bytes >= 1024)       return (bytes / 1024).toFixed(2) + ' KB';
            return bytes + ' B';
        }

        function formatDate(iso) {
            if (!iso) return '—';
            return window.DateFmt.formatTimestamp(iso);
        }

        // ── Delete confirmation modal ────────────────────────────────────────

        const _dcBackdrop  = document.getElementById('delete-confirm-backdrop');
        const _dcMessage   = document.getElementById('delete-confirm-message');
        const _dcClose     = document.getElementById('delete-confirm-close');
        const _dcCancel    = document.getElementById('delete-confirm-cancel');
        const _dcOk        = document.getElementById('delete-confirm-ok');

        // Focusable elements inside the modal (order determines Tab cycle).
        const _dcFocusable = [_dcOk, _dcCancel, _dcClose];

        let _dcResolve = null;

        function _dcHide() {
            _dcBackdrop.hidden = true;
            document.body.classList.remove('entity-detail-open');
            if (_dcResolve) {
                const r = _dcResolve;
                _dcResolve = null;
                r(false);
            }
        }

        function showDeleteConfirm(msg) {
            _dcMessage.textContent = msg;
            _dcOk.textContent = 'Delete';
            _dcOk.disabled = false;
            _dcBackdrop.hidden = false;
            document.body.classList.add('entity-detail-open');

            // Focus the Delete button so the destructive action requires
            // deliberate Tab-away; also satisfies focus-trap on open.
            _dcOk.focus();

            return new Promise(resolve => {
                _dcResolve = resolve;
            });
        }

        // Confirm (Delete) button
        _dcOk.addEventListener('click', () => {
            if (_dcResolve) {
                const r = _dcResolve;
                _dcResolve = null;
                r(true);
            }
        });

        // Cancel and close (×) buttons
        _dcClose.addEventListener('click',  _dcHide);
        _dcCancel.addEventListener('click', _dcHide);

        // Clicking the backdrop outside the modal shell closes it
        _dcBackdrop.addEventListener('click', e => {
            if (e.target === _dcBackdrop) _dcHide();
        });

        // Escape key cancels
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && !_dcBackdrop.hidden) {
                e.preventDefault();
                _dcHide();
            }
        });

        // Focus trap: Tab cycles only among _dcFocusable while the modal is open
        _dcBackdrop.addEventListener('keydown', e => {
            if (e.key !== 'Tab') return;
            const focused = document.activeElement;
            const idx = _dcFocusable.indexOf(focused);
            const len = _dcFocusable.length;
            if (e.shiftKey) {
                e.preventDefault();
                _dcFocusable[(idx <= 0 ? len : idx) - 1].focus();
            } else {
                e.preventDefault();
                _dcFocusable[(idx + 1) % len].focus();
            }
        });

        // ── Delete file action ───────────────────────────────────────────────

        async function deleteFile(id, confirmMsg) {
            const confirmed = await showDeleteConfirm(confirmMsg || 'Delete this file?');
            if (!confirmed) return;

            // Loading state on the Delete button while the request is in flight.
            _dcOk.textContent = 'Deleting…';
            _dcOk.disabled = true;
            _dcCancel.disabled = true;
            _dcClose.disabled = true;

            try {
                const res = await fetch(`/files/${id}`, {
                    method: 'DELETE',
                    headers: { 'RequestVerificationToken': antiforgeryToken() }
                });
                if (!res.ok) throw new Error('Delete failed.');

                // Success — hide the modal and refresh the list.
                _dcBackdrop.hidden = true;
                document.body.classList.remove('entity-detail-open');
                loadFiles();
            } catch (e) {
                // On error: restore buttons and keep the modal open so the user
                // can retry or cancel without losing context.
                _dcOk.textContent = 'Delete';
                _dcOk.disabled = false;
                _dcCancel.disabled = false;
                _dcClose.disabled = false;
                _dcMessage.textContent = 'Error: ' + e.message + ' — ' + (confirmMsg || 'Delete this file?');
                _dcOk.focus();
            }
        }

        // ── File list ────────────────────────────────────────────────────────

        let allFiles = [];

        function fileHaystack(f) {
            return [
                f.name,
                formatSize(f.size),
                f.contentType || '',
                formatDate(f.uploadedAt)
            ].join(' ').toLowerCase();
        }

        function filterFiles(query) {
            const tokens = query.toLowerCase().split(/\s+/).filter(Boolean);
            if (!tokens.length) return allFiles;
            return allFiles.filter(f => {
                const haystack = fileHaystack(f);
                return tokens.every(t => haystack.includes(t));
            });
        }

        function renderFiles(files) {
            const container = document.getElementById('files-list-container');

            const rows = files.map(f => {
                const albumBadge = f.linkedAlbumId
                    ? `<span class="files-album-cover-badge">Album cover &middot; <a href="/lib/albums/edit/${f.linkedAlbumId}">${escapeHtml(f.linkedAlbumName || f.linkedAlbumId)}</a></span>`
                    : '';
                const deleteConfirm = f.linkedAlbumId
                    ? 'Delete this file? This will also remove the cover from the album.'
                    : 'Delete this file?';
                return `
                    <tr>
                        <td data-label="Name">${escapeHtml(f.name)}${albumBadge}</td>
                        <td data-label="Size">${formatSize(f.size)}</td>
                        <td data-label="Type">${escapeHtml(f.contentType || '—')}</td>
                        <td data-label="Uploaded">${formatDate(f.uploadedAt)}</td>
                        <td data-label="Actions" class="cell-actions">
                            <a class="btn" href="/files/download/${f.id}" download="${escapeHtml(f.name)}">Download</a>
                            <button class="btn btn-danger files-delete-btn" data-id="${f.id}" data-confirm="${escapeHtml(deleteConfirm)}">Delete</button>
                        </td>
                    </tr>
                `;
            }).join('');

            const body = files.length
                ? rows
                : '<tr><td colspan="5">No results</td></tr>';

            container.innerHTML = `
                <div class="table-wrap">
                    <table class="entity-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Size</th>
                                <th>Type</th>
                                <th>Uploaded</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>${body}</tbody>
                    </table>
                </div>
            `;

            container.querySelectorAll('.files-delete-btn').forEach(btn => {
                btn.addEventListener('click', () => deleteFile(btn.dataset.id, btn.dataset.confirm));
            });
        }

        function applyFilter() {
            const searchInput = document.getElementById('fileSearch');
            const status = document.querySelector('.search-status');
            const filtered = filterFiles(searchInput.value.trim());
            renderFiles(filtered);
            if (status) status.textContent = filtered.length === 0 ? 'No results' : '';
        }

        async function loadFiles() {
            const container = document.getElementById('files-list-container');
            const searchInput = document.getElementById('fileSearch');
            try {
                const res = await fetch('/files/list');
                if (!res.ok) throw new Error('Failed to load files.');
                allFiles = await res.json();

                if (!allFiles.length) {
                    if (searchInput) searchInput.disabled = true;
                    container.innerHTML = '<p class="files-empty">No files uploaded yet.</p>';
                    return;
                }

                if (searchInput) searchInput.disabled = false;
                applyFilter();
            } catch (e) {
                if (searchInput) searchInput.disabled = true;
                container.innerHTML = `<p class="files-empty">${escapeHtml(e.message)}</p>`;
            }
        }

        function escapeHtml(str) {
            if (str == null) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        const fileSearch = document.getElementById('fileSearch');
        let searchTimer = 0;
        fileSearch.addEventListener('input', () => {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(applyFilter, 250);
        });

        // Exposed so the async upload widget (files-upload.js) can refresh the list.
        window.loadFiles = loadFiles;

        loadFiles();
    </script>
    <script src="https://unpkg.com/dropzone@5/dist/min/dropzone.min.js"></script>
    <script src="~/js/files-upload.js" asp-append-version="true"></script>
}
