@model spotify_swiss_knife.Models.ShufflePlaylistPage

@{
    ViewData["Title"] = "Shuffle Playlists";
}

@section Head {
    <link rel="stylesheet" href="~/css/bulk-album-save.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/shuffle.css" asp-append-version="true">
}

<section class="library-page shuffle-page">
    <h1>Shuffle Playlists</h1>
    <p>Pick one or more playlists and shuffle their tracks in place.</p>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <section class="shuffle-notice shuffle-notice-error" role="alert" aria-labelledby="shuffleErrorTitle">
            <h2 id="shuffleErrorTitle" class="shuffle-notice-title">Playlists unavailable</h2>
            <p class="shuffle-notice-text">@Model.ErrorMessage</p>
        </section>
    }
    else
    {
        <form id="shuffleForm"
              class="shuffle-form"
              action="@Url.Action("Index", "Shuffle")"
              method="post">
            @Html.AntiForgeryToken()

            <div class="shuffle-playlist-panel-wrap">
                <section class="bulk-save-panel shuffle-playlist-panel" aria-labelledby="shufflePlaylistsTitle">
                    <div class="bulk-save-panel-head">
                        <h2 id="shufflePlaylistsTitle" class="shuffle-panel-title">Playlists</h2>
                        <span class="bulk-save-count" id="shufflePlaylistCount" aria-live="polite">0 playlists selected</span>
                    </div>

                    <div class="search-box bulk-save-search">
                        <label for="shufflePlaylistSearch" class="visually-hidden">Search your playlists</label>
                        <div class="search-input-wrap">
                            <input id="shufflePlaylistSearch"
                                   type="search"
                                   class="search-input"
                                   placeholder="Search your playlists..."
                                   autocomplete="off"
                                   aria-label="Search your playlists"
                                   aria-controls="shufflePlaylistTableBody" />
                            <button type="button" class="search-clear-btn" id="shufflePlaylistSearchClear" hidden aria-label="Clear search">
                                <svg aria-hidden="true" focusable="false" width="10" height="10" viewBox="0 0 12 12"><line x1="1" y1="1" x2="11" y2="11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="11" y1="1" x2="1" y2="11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                            </button>
                        </div>
                        <span class="search-status bulk-save-search-status" id="shufflePlaylistSearchStatus" aria-live="polite"></span>
                    </div>

                    <div class="table-wrap bulk-save-table-wrap shuffle-table-wrap">
                        <table class="entity-table bulk-save-table">
                            <thead>
                                <tr>
                                    <th scope="col">Cover</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Tracks</th>
                                </tr>
                            </thead>
                            <tbody id="shufflePlaylistTableBody">
                            </tbody>
                        </table>
                        <p class="bulk-save-empty" id="shufflePlaylistEmpty">No playlists found.</p>
                    </div>
                </section>
            </div>

            <div class="shuffle-actions">
                <button type="submit" class="shuffle-submit" id="shuffleSubmit" disabled>
                    <span class="shuffle-spinner" aria-hidden="true"></span>
                    <span class="shuffle-submit-label">Start shuffle</span>
                </button>
                <p class="shuffle-validation bulk-save-hint" id="shuffleHint">Select at least one playlist.</p>
                <p class="shuffle-status" id="shuffleStatus" role="status" aria-live="polite" aria-atomic="true"></p>
                <p class="shuffle-last-run" id="shuffleLastRun" hidden>
                    Last shuffled: <time class="shuffle-time" id="shuffleTime"></time>
                </p>
            </div>

            <div id="shuffleHiddenInputs" hidden></div>
        </form>
    }
</section>

@if (string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <script id="shufflePlaylistData" type="application/json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Playlists.Select(p => new
            {
                id = p.Id,
                name = p.Name ?? "",
                tracks = p.Tracks?.Total ?? 0,
                imageUrl = p.Images?.FirstOrDefault()?.Url
            }),
            new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }))
    </script>
}

@section Scripts {
    @if (string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <script src="~/js/bulk-grid-utils.js" asp-append-version="true"></script>
        <script src="~/js/shuffle.js" asp-append-version="true"></script>
    }
}
