@using spotify_swiss_knife.Models.FormModels;

@model ArtistCreateForm

@{
    ViewData["Title"] = "Create Artist";
}

<div class="form-container">
    <h2>Create New Artist</h2>

    <form method="post" id="createArtistForm" data-validate="true">
        @Html.AntiForgeryToken()

        <partial name="_NameInput" model="Model" />
        <partial name="_SpotifyUrlInput" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Artist</button>
            <a href="@Url.Action("Artists", "Artists")" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/form-validation.js" asp-append-version="true"></script>
}
