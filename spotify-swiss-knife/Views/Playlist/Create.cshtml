@using spotify_swiss_knife.Models.FormModels;

@model PlaylistCreateModel

@{
    ViewData["Title"] = "Create Playlist";
}

<div class="form-container">
    <h2>Create New Playlist</h2>
    
    <form method="post" id="createPlaylistForm" data-validate="true">
        @Html.AntiForgeryToken()
        
        <div class="form-group">
            <label for="Name" class="required">Playlist Name</label>
            <input 
                type="text" 
                id="Name" 
                name="Name" 
                class="form-control" 
                value="@Model.Name"
                required
                maxlength="200"
                data-val-length-max="200"
                data-val-length-min="1"
                placeholder="Enter playlist name"
                aria-label="Playlist Name"
                aria-describedby="error-Name"
            />
            @{
                var nameErrors = ViewData.ModelState["Name"]?.Errors;
                if (nameErrors != null && nameErrors.Count > 0)
                {
                    <div class="validation-error show" id="error-Name" role="alert" aria-live="polite">
                        @foreach (var error in nameErrors)
                        {
                            <div class="validation-error-message">@error.ErrorMessage</div>
                        }
                    </div>
                }
                else
                {
                    <div class="validation-error" id="error-Name" role="alert" aria-live="polite"></div>
                }
            }
        </div>

        <div class="form-group">
            <label for="Description">Description</label>
            <textarea
                id="Description" 
                name="Description" 
                class="form-control" 
                rows="4"
                maxlength="500"
                data-val-length-max="500"
                placeholder="Enter playlist description (optional)"
                aria-label="Description"
                aria-describedby="error-Description"
            >@Model.Description</textarea>
            @{
                var descriptionErrors = ViewData.ModelState["Description"]?.Errors;
                if (descriptionErrors != null && descriptionErrors.Count > 0)
                {
                    <div class="validation-error show" id="error-Description" role="alert" aria-live="polite">
                        @foreach (var error in descriptionErrors)
                        {
                            <div class="validation-error-message">@error.ErrorMessage</div>
                        }
                    </div>
                }
                else
                {
                    <div class="validation-error" id="error-Description" role="alert" aria-live="polite"></div>
                }
            }
        </div>

        <div class="form-group">
            <label for="OwnerDisplayName">Owner</label>
            <input
                type="text"
                id="OwnerDisplayName"
                name="OwnerDisplayName"
                class="form-control"
                value="@Model.OwnerDisplayName"
                maxlength="100"
                data-val-length-max="100"
                placeholder="Enter owner name (optional)"
                aria-label="Owner"
                aria-describedby="error-OwnerDisplayName"
            />
            @{
                var ownerDisplayNameErrors = ViewData.ModelState["OwnerDisplayName"]?.Errors;
                if (ownerDisplayNameErrors != null && ownerDisplayNameErrors.Count > 0)
                {
                    <div class="validation-error show" id="error-OwnerDisplayName" role="alert" aria-live="polite">
                        @foreach (var error in ownerDisplayNameErrors)
                        {
                            <div class="validation-error-message">@error.ErrorMessage</div>
                        }
                    </div>
                }
                else
                {
                    <div class="validation-error" id="error-OwnerDisplayName" role="alert" aria-live="polite"></div>
                }
            }
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Playlist</button>
            <a href="@Url.Action("Index", "Library", new { section = "Playlists" })" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

