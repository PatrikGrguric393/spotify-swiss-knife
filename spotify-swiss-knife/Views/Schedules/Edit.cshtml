@using spotify_swiss_knife.Models
@model spotify_swiss_knife.Models.FormModels.EditScheduleForm

@{
    ViewData["Title"] = "Edit scheduled shuffle";
    ViewData["SubmitLabel"] = "Save changes";
    var playlists = (ViewBag.Playlists as IEnumerable<spotify_swiss_knife.Models.Playlist>) ?? Enumerable.Empty<spotify_swiss_knife.Models.Playlist>();
    // Only the initial Edit GET seeds the fields with UTC values that need localizing.
    // Create renders "false"; an Edit POST re-render also renders "false" because the
    // fields already hold the user's local selection.
    var localizeFromUtc = (ViewBag.LocalizeFromUtc as bool?) == true ? "true" : "false";
}

@section Head {
    <link rel="stylesheet" href="~/css/bulk-album-save.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/shuffle.css" asp-append-version="true">
}

<section class="library-page shuffle-page">
    <h1>Edit scheduled shuffle</h1>

    <section class="shuffle-panel" aria-labelledby="editScheduleTitle">
        <h2 id="editScheduleTitle" class="shuffle-panel-title">Configure schedule</h2>

        <form method="post" action="@Url.Action("Edit", "Schedules", new { id = Model.Id })" class="shuffle-form" data-utc-seed="@localizeFromUtc">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            @await Html.PartialAsync("_ScheduleFormFields", Model)
        </form>
    </section>
</section>

<script id="schedulePlaylistData" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        playlists.Select(p => new
        {
            id = p.Id,
            name = p.Name ?? "",
            tracks = p.Tracks?.Total ?? 0,
            imageUrl = p.Images?.FirstOrDefault()?.Url
        }),
        new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }))
</script>

<script id="scheduleSelectedPlaylistIds" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.PlaylistIds ?? new List<string>(),
        new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }))
</script>

@section Scripts {
    <script src="~/js/bulk-grid-utils.js" asp-append-version="true"></script>
    <script src="~/js/schedule-form.js" asp-append-version="true"></script>
}
