@model List<spotify_swiss_knife.Models.ScheduledShuffle>

@{
    ViewData["Title"] = "Scheduled Shuffles";
}

@section Head {
    <link rel="stylesheet" href="~/css/shuffle.css" asp-append-version="true">
}

<section class="library-page shuffle-page">
    <h1>Scheduled Shuffles</h1>

    <div class="library-actions">
        <a href="@Url.Action("Create", "Schedules")" class="shuffle-submit">New schedule</a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <section class="shuffle-notice" role="status" aria-labelledby="scheduleEmptyTitle">
            <h2 id="scheduleEmptyTitle" class="shuffle-notice-title">No scheduled shuffles</h2>
            <p class="shuffle-notice-text">You have not set up any scheduled shuffles yet. Use the "New schedule" button above to create one.</p>
        </section>
    }
    else
    {
        <div class="table-wrap">
            <table class="entity-table">
                <thead>
                    <tr>
                        <th>Playlist</th>
                        <th>Schedule</th>
                        <th>Status</th>
                        <th>Next run</th>
                        <th>Last run</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var schedule in Model)
                {
                    var playlistNames = schedule.PlaylistNames ?? new List<string>();
                    var playlistCount = playlistNames.Count;
                    var playlistSummary = playlistCount > 0
                        ? string.Join(", ", playlistNames)
                        : (playlistCount == 0 ? "No playlists" : "");
                    var playlistAria = playlistCount switch
                    {
                        0 => "no playlists",
                        1 => playlistNames[0],
                        _ => $"{playlistCount} playlists"
                    };
                    <tr>
                        <td data-label="Playlist">
                            @if (playlistCount > 1)
                            {
                                <ul class="schedule-playlist-list">
                                    @foreach (var name in playlistNames)
                                    {
                                        <li>@name</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                @playlistSummary
                            }
                        </td>
                        <td data-label="Schedule"><code>@schedule.CronExpression</code></td>
                        <td data-label="Status">
                            @if (schedule.IsEnabled)
                            {
                                <span class="schedule-badge schedule-badge--enabled">Enabled</span>
                            }
                            else
                            {
                                <span class="schedule-badge schedule-badge--disabled">Disabled</span>
                            }
                        </td>
                        <td data-label="Next run">
                            @if (schedule.NextRunAt.HasValue)
                            {
                                <time class="shuffle-time shuffle-time--pending" data-utc="@schedule.NextRunAt.Value.UtcDateTime.ToString("O")">@schedule.NextRunAt.Value.UtcDateTime.ToString("O")</time>
                            }
                            else
                            {
                                <span class="schedule-never">—</span>
                            }
                        </td>
                        <td data-label="Last run">
                            @if (schedule.LastRunAt.HasValue)
                            {
                                <time class="shuffle-time shuffle-time--pending" data-utc="@schedule.LastRunAt.Value.UtcDateTime.ToString("O")">@schedule.LastRunAt.Value.UtcDateTime.ToString("O")</time>
                            }
                            else
                            {
                                <span class="schedule-never">Never</span>
                            }
                        </td>
                        <td data-label="Actions" class="cell-actions">
                            <div class="schedule-actions">
                                <form method="post" action="@Url.Action("Toggle", "Schedules", new { id = schedule.Id })">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="shuffle-submit"
                                            aria-label="@(schedule.IsEnabled ? "Disable" : "Enable") schedule for @playlistAria">
                                        @(schedule.IsEnabled ? "Disable" : "Enable")
                                    </button>
                                </form>
                                <form method="post" action="@Url.Action("Delete", "Schedules", new { id = schedule.Id })">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="shuffle-submit btn-danger"
                                            aria-label="Delete schedule for @playlistAria"
                                            data-confirm="Delete schedule for @playlistAria?">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        window.DateFmt.localizePending();

        // Confirm before destructive delete actions
        document.querySelectorAll('button[data-confirm]').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                if (!window.confirm(btn.dataset.confirm)) {
                    e.preventDefault();
                }
            });
        });
    });
    </script>
}
