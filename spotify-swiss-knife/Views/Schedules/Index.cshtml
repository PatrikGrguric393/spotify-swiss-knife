@model List<spotify_swiss_knife.Models.ScheduledShuffle>

@{
    ViewData["Title"] = "Scheduled Shuffles";
}

@section Head {
    <link rel="stylesheet" href="~/css/shuffle.css" asp-append-version="true">
}

<section class="library-page shuffle-page">
    <h1>Scheduled Shuffles</h1>

    <div class="library-actions">
        <a href="@Url.Action("Create", "Schedules")" class="shuffle-submit">New schedule</a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <section class="shuffle-notice" role="status" aria-labelledby="scheduleEmptyTitle">
            <h2 id="scheduleEmptyTitle" class="shuffle-notice-title">No scheduled shuffles</h2>
            <p class="shuffle-notice-text">You have not set up any scheduled shuffles yet. Use the "New schedule" button above to create one.</p>
        </section>
    }
    else
    {
        <div class="table-wrap">
            <table class="entity-table">
                <thead>
                    <tr>
                        <th>Playlist</th>
                        <th>Schedule</th>
                        <th>Status</th>
                        <th>Next run</th>
                        <th>Last run</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var schedule in Model)
                {
                    var playlistNames = schedule.PlaylistNames ?? new List<string>();
                    var playlistCount = playlistNames.Count;
                    var playlistSummary = playlistCount > 0
                        ? string.Join(", ", playlistNames)
                        : (playlistCount == 0 ? "No playlists" : "");
                    var playlistAria = playlistCount switch
                    {
                        0 => "no playlists",
                        1 => playlistNames[0],
                        _ => $"{playlistCount} playlists"
                    };
                    <tr>
                        <td data-label="Playlist">
                            @if (playlistCount > 1)
                            {
                                <ul class="schedule-playlist-list">
                                    @foreach (var name in playlistNames)
                                    {
                                        <li>@name</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                @playlistSummary
                            }
                        </td>
                        <td data-label="Schedule"><code>@schedule.CronExpression</code></td>
                        <td data-label="Status">
                            @if (schedule.IsEnabled)
                            {
                                <span class="schedule-badge schedule-badge--enabled">Enabled</span>
                            }
                            else
                            {
                                <span class="schedule-badge schedule-badge--disabled">Disabled</span>
                            }
                        </td>
                        <td data-label="Next run">
                            @if (schedule.NextRunAt.HasValue)
                            {
                                <time class="shuffle-time shuffle-time--pending" data-utc="@schedule.NextRunAt.Value.UtcDateTime.ToString("O")">@schedule.NextRunAt.Value.UtcDateTime.ToString("O")</time>
                            }
                            else
                            {
                                <span class="schedule-never">—</span>
                            }
                        </td>
                        <td data-label="Last run">
                            @if (schedule.LastRunAt.HasValue)
                            {
                                <time class="shuffle-time shuffle-time--pending" data-utc="@schedule.LastRunAt.Value.UtcDateTime.ToString("O")">@schedule.LastRunAt.Value.UtcDateTime.ToString("O")</time>
                            }
                            else
                            {
                                <span class="schedule-never">Never</span>
                            }
                        </td>
                        <td data-label="Actions" class="cell-actions">
                            <div class="schedule-actions">
                                <form method="post" action="@Url.Action("Toggle", "Schedules", new { id = schedule.Id })">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="shuffle-submit"
                                            aria-label="@(schedule.IsEnabled ? "Disable" : "Enable") schedule for @playlistAria">
                                        @(schedule.IsEnabled ? "Disable" : "Enable")
                                    </button>
                                </form>
                                <form method="post" action="@Url.Action("Delete", "Schedules", new { id = schedule.Id })">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="shuffle-submit btn-danger"
                                            aria-label="Delete schedule for @playlistAria"
                                            data-confirm="Delete schedule for @playlistAria?">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<div class="entity-detail-backdrop" id="deleteConfirmBackdrop" hidden
     role="dialog" aria-modal="true" aria-labelledby="deleteConfirmTitle">
    <div class="entity-detail-modal confirm-modal">
        <div class="entity-detail-header">
            <h2 class="entity-detail-header-title" id="deleteConfirmTitle">Delete schedule?</h2>
            <button type="button" class="entity-detail-close" id="deleteConfirmClose" aria-label="Cancel deletion">&#x2715;</button>
        </div>
        <div class="entity-detail-body">
            <p class="confirm-modal-message" id="deleteConfirmMessage"></p>
        </div>
        <div class="confirm-modal-footer">
            <button type="button" class="shuffle-submit" id="deleteConfirmCancel">Cancel</button>
            <button type="button" class="shuffle-submit btn-danger" id="deleteConfirmOk">Delete</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        window.DateFmt.localizePending();

        var backdrop   = document.getElementById('deleteConfirmBackdrop');
        var msgEl      = document.getElementById('deleteConfirmMessage');
        var cancelBtn  = document.getElementById('deleteConfirmCancel');
        var closeBtn   = document.getElementById('deleteConfirmClose');
        var okBtn      = document.getElementById('deleteConfirmOk');

        var pendingForm   = null;
        var previousFocus = null;

        var focusable = [closeBtn, cancelBtn, okBtn];

        function openModal(form, message) {
            pendingForm   = form;
            previousFocus = document.activeElement;
            msgEl.textContent = message;
            backdrop.removeAttribute('hidden');
            cancelBtn.focus();
        }

        function closeModal() {
            backdrop.setAttribute('hidden', '');
            pendingForm = null;
            if (previousFocus) {
                previousFocus.focus();
            }
        }

        // Intercept all delete form submits via the data-confirm button
        document.querySelectorAll('button[data-confirm]').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                openModal(btn.closest('form'), btn.dataset.confirm);
            });
        });

        // Confirm: submit the pending form
        okBtn.addEventListener('click', function () {
            closeModal();
            if (pendingForm) {
                pendingForm.submit();
            }
        });

        // Cancel via button or close-X
        cancelBtn.addEventListener('click', closeModal);
        closeBtn.addEventListener('click',  closeModal);

        // Cancel via backdrop click (but not inside the modal panel)
        backdrop.addEventListener('click', function (e) {
            if (e.target === backdrop) {
                closeModal();
            }
        });

        // Cancel via Escape; trap Tab focus inside the dialog
        backdrop.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                e.preventDefault();
                closeModal();
                return;
            }

            if (e.key === 'Tab') {
                e.preventDefault();
                var current = document.activeElement;
                var idx     = focusable.indexOf(current);
                if (e.shiftKey) {
                    idx = (idx - 1 + focusable.length) % focusable.length;
                } else {
                    idx = (idx + 1) % focusable.length;
                }
                focusable[idx].focus();
            }
        });
    });
    </script>
}
