@using spotify_swiss_knife.Models
@model spotify_swiss_knife.Models.FormModels.CreateScheduleForm

@{
    ViewData["Title"] = "New Scheduled Shuffle";
    var playlists = (ViewBag.Playlists as IEnumerable<spotify_swiss_knife.Models.Playlist>) ?? Enumerable.Empty<spotify_swiss_knife.Models.Playlist>();
}

<section class="library-page shuffle-page">
    <h1>New Scheduled Shuffle</h1>

    <section class="shuffle-panel" aria-labelledby="createScheduleTitle">
        <h2 id="createScheduleTitle" class="shuffle-panel-title">Configure schedule</h2>

        <form method="post" action="@Url.Action("Create", "Schedules")" class="shuffle-form">
            @Html.AntiForgeryToken()

            <input type="hidden" name="PlaylistName" id="PlaylistName" value="@Model.PlaylistName" />

            <div class="shuffle-form-row">
                <label for="PlaylistId">Playlist</label>
                <select id="PlaylistId" name="PlaylistId" class="shuffle-input" required>
                    <option value="">Select playlist</option>
                    @foreach (var playlist in playlists)
                    {
                        <option value="@playlist.Id" selected="@(Model.PlaylistId == playlist.Id ? "selected" : null)">@playlist.Name</option>
                    }
                </select>
                <span class="shuffle-validation" asp-validation-for="PlaylistId"></span>
            </div>

            <div class="shuffle-form-row">
                <label asp-for="RandomnessLevel">Randomness level</label>
                <select asp-for="RandomnessLevel" class="shuffle-input">
                    @foreach (var level in Enum.GetValues<ShuffleRandomnessLevel>())
                    {
                        <option value="@((int)level)">@level</option>
                    }
                </select>
                <span class="shuffle-validation" asp-validation-for="RandomnessLevel"></span>
            </div>

            <div class="shuffle-form-row">
                <label>Days of week</label>
                <div class="schedule-days">
                    @{
                        var dayNames = new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
                        for (int d = 0; d <= 6; d++)
                        {
                            var isChecked = Model.DaysOfWeek != null && Model.DaysOfWeek.Contains(d);
                            <label class="shuffle-checkbox">
                                <input type="checkbox" name="DaysOfWeek" value="@d" @(isChecked ? "checked" : null) />
                                @dayNames[d]
                            </label>
                        }
                    }
                </div>
                <span class="shuffle-validation" asp-validation-for="DaysOfWeek"></span>
            </div>

            <div class="shuffle-form-row">
                @{
                    var timeParts = (Model.TimeUtc ?? "08:00").Split(':');
                    var hourValue = timeParts.Length > 0 ? timeParts[0] : "08";
                    var minuteValue = timeParts.Length > 1 ? timeParts[1] : "00";
                }
                <span class="shuffle-form-label" id="timeUtcLabel">Time (your local time)</span>
                <div class="schedule-time-picker" role="group" aria-labelledby="timeUtcLabel">
                    <input type="number" id="TimeUtcHour" class="shuffle-input schedule-time-part"
                           min="0" max="23" step="1" inputmode="numeric" autocomplete="off"
                           value="@hourValue" aria-label="Hour (00 to 23)" />
                    <span class="schedule-time-sep" aria-hidden="true">:</span>
                    <input type="number" id="TimeUtcMinute" class="shuffle-input schedule-time-part"
                           min="0" max="59" step="1" inputmode="numeric" autocomplete="off"
                           value="@minuteValue" aria-label="Minute (00 to 59)" />
                </div>
                <span class="schedule-time-zone" id="scheduleTimeZone" hidden></span>
                <span class="schedule-time-utc-hint" id="scheduleTimeUtcHint" aria-live="polite" hidden></span>
                <input asp-for="TimeUtc" type="hidden" />
                <input type="hidden" name="TimezoneOffsetMinutes" id="TimezoneOffsetMinutes" />
                <span class="shuffle-validation" asp-validation-for="TimeUtc"></span>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="shuffle-notice shuffle-notice-error" role="alert" aria-labelledby="scheduleValidationTitle">
                    <h3 id="scheduleValidationTitle" class="shuffle-notice-title">Please fix the following errors</h3>
                    <div asp-validation-summary="ModelOnly" class="shuffle-notice-text"></div>
                </div>
            }

            <div class="shuffle-form-actions">
                <div class="schedule-form-buttons">
                    <button type="submit" class="shuffle-submit">Create schedule</button>
                    <a href="@Url.Action("Index", "Schedules")" class="shuffle-submit schedule-cancel-link">Cancel</a>
                </div>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    <script>
    (function () {
        var select = document.getElementById('PlaylistId');
        var hidden = document.getElementById('PlaylistName');

        function syncName() {
            var opt = select.options[select.selectedIndex];
            hidden.value = opt && opt.value ? opt.text : '';
        }

        if (select) {
            syncName();
            select.addEventListener('change', syncName);
        }
    }());

    (function () {
        var hourEl = document.getElementById('TimeUtcHour');
        var minuteEl = document.getElementById('TimeUtcMinute');
        var hidden = document.getElementById('TimeUtc');
        var offsetEl = document.getElementById('TimezoneOffsetMinutes');
        var zoneEl = document.getElementById('scheduleTimeZone');
        var utcHintEl = document.getElementById('scheduleTimeUtcHint');
        if (!hourEl || !minuteEl || !hidden) { return; }

        function pad(value, max) {
            var n = parseInt(value, 10);
            if (isNaN(n)) { n = 0; }
            if (n < 0) { n = 0; }
            if (n > max) { n = max; }
            return ('0' + n).slice(-2);
        }

        // Same value the server reads: minutes to add to local time to reach UTC.
        function offsetMinutes() {
            return new Date().getTimezoneOffset();
        }

        function setOffset() {
            if (offsetEl) { offsetEl.value = String(offsetMinutes()); }
        }

        function setZone() {
            if (!zoneEl) { return; }
            var zone = '';
            try { zone = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) { zone = ''; }
            if (zone) {
                zoneEl.textContent = 'Detected timezone: ' + zone;
                zoneEl.hidden = false;
            }
        }

        function updateUtcHint() {
            if (!utcHintEl) { return; }
            var totalLocal = parseInt(pad(hourEl.value, 23), 10) * 60 + parseInt(pad(minuteEl.value, 59), 10);
            var totalUtc = ((totalLocal + offsetMinutes()) % 1440 + 1440) % 1440;
            utcHintEl.textContent = '= ' + pad(Math.floor(totalUtc / 60), 23) + ':' + pad(totalUtc % 60, 59) + ' UTC';
            utcHintEl.hidden = false;
        }

        function sync() {
            hidden.value = pad(hourEl.value, 23) + ':' + pad(minuteEl.value, 59);
            setOffset();
            updateUtcHint();
        }

        function clamp(el, max) {
            el.value = pad(el.value, max);
        }

        hourEl.addEventListener('input', sync);
        minuteEl.addEventListener('input', sync);
        hourEl.addEventListener('blur', function () { clamp(hourEl, 23); sync(); });
        minuteEl.addEventListener('blur', function () { clamp(minuteEl, 59); sync(); });
        hourEl.form.addEventListener('submit', function () { clamp(hourEl, 23); clamp(minuteEl, 59); sync(); });

        setZone();
        sync();
    }());
    </script>
}
